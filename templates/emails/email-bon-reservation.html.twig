<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Bon de réservation - AutoPro</title>
  <style>
    body { margin:0; padding:0; background:#f5f7f9; -webkit-text-size-adjust:100%; }
    table { border-collapse:collapse; }
    body, table, td, p, div, a { font-family:Verdana,Geneva,sans-serif; }
    img { border:0; outline:none; text-decoration:none; }
    a { color:#C81214; }
    @media (max-width: 620px) {
      .container { width:100% !important; }
      .px { padding-left:20px !important; padding-right:20px !important; }
      .col { display:block !important; width:100% !important; }
      .col-img { padding:0 0 14px 0 !important; }
      .h1 { font-size:22px !important; }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:#f5f7f9;font-family:Verdana,Geneva,sans-serif;color:#000000;">

  <!-- Texte d'aperçu -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;color:#f5f7f9;">
    Réglez l'acompte par virement pour confirmer votre réservation n° {{reservation.reservationNumber}}.
  </div>

  <!-- ===== EN-TETE DE MAQUETTE (à retirer en production) ===== -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#e9edf1;">
    <tr>
      <td align="center" style="padding:14px 16px;font-family:Verdana,Geneva,sans-serif;font-size:12px;color:#555555;line-height:1.6;">
        <strong>De :</strong> AutoPro &lt;noreply@autopro.sale&gt; &nbsp;|&nbsp;
        <strong>Objet :</strong> Bon de réservation n° {{reservation.reservationNumber }} : acompte à régler par virement
      </td>
    </tr>
  </table>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f9;">
    <tr>
      <td align="center" style="padding:24px 12px 40px;">

        <!-- ===== CONTENEUR 600px ===== -->
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#FFFFFF;border:1px solid #E6E3DC;font-family:Verdana,Geneva,sans-serif;">

          <!-- Logo -->
          <tr>
            <td class="px" align="center" style="padding:22px 32px;border-top:4px solid #ED1719;border-bottom:1px solid #E6E3DC;">
              <!-- Remplace par : <img src="https://.../logo-autopro.png" width="150" alt="AutoPro"> -->
              <span style="font-family:Verdana,Geneva,sans-serif;font-size:26px;font-weight:700;letter-spacing:1px;color:#000000;">AUTO<span style="color:#ED1719;">PRO</span></span>
            </td>
          </tr>

          <!-- Confirmation -->
          <tr>
            <td class="px" align="center" style="padding:32px 32px 0;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" width="48" height="48" bgcolor="#000000" style="width:48px;height:48px;background:#000000;border-radius:24px;color:#FFFFFF;font-size:24px;font-weight:700;line-height:48px;">&euro;</td>
                </tr>
              </table>
              <p class="h1" style="margin:16px 0 0;font-size:26px;line-height:1.25;font-weight:700;color:#000000;">Votre réservation est enregistrée</p>
              <p style="margin:12px 0 0;font-size:14px;line-height:1.7;color:#555555;">
                Bonjour <b style="color:#000000">{{ reservation.customerName }}</b>, merci pour votre confiance. Pour confirmer votre réservation et retirer le véhicule de la vente à votre nom,
                réglez l'acompte par virement bancaire avec les coordonnées ci-dessous.
              </p>
            </td>
          </tr>

          <!-- Bon : numéro, date, statut -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px dashed #E6E3DC;background:#f5f7f9;">
                <tr>
                  <td class="col" width="40%" valign="top" style="padding:16px 18px;">
                    <div style="font-size:12px;color:#555555;">Bon de réservation n°</div>
                    <div style="padding-top:2px;font-size:16px;font-weight:700;color:#000000;">{{reservation.reservationNumber }}</div>
                  </td>
                  <td class="col" width="30%" valign="top" style="padding:16px 18px;">
                    <div style="font-size:12px;color:#555555;">Date</div>
                    <div style="padding-top:2px;font-size:14px;font-weight:600;color:#000000;">{{reservation.createdAt|date('d/m/Y') }}, {{reservation.createdAt|date('H:m') }}</div>
                  </td>
                  <td class="col" width="30%" valign="top" style="padding:16px 18px;">
                    <div style="font-size:12px;color:#555555;">Statut</div>
                    <div style="padding-top:2px;font-size:14px;font-weight:600;color:#000000;">En attente d'acompte</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Véhicule réservé -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Véhicule réservé</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6E3DC;">
                <tr>
                  <td class="col col-img" width="200" valign="top" style="padding:14px 0 14px 14px;">
                    <img 
                         src="{{ absolute_url(
                              asset(
                                  'uploads/vehicles/' ~ reservation.vehicle.getPrimaryImage().filename
                              )
                          ) }}"
                         width="186" alt="Photo du véhicule réservé" style="display:block;width:100%;height:auto;border:0;border-radius:8px;">
                  </td>
                  <td class="col" valign="top" style="padding:14px 16px;">
                    <span style="display:inline-block;background:#FFCC00;color:#000000;border-radius:2px;font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;padding:3px 8px;">Occasion</span>
                    <div style="padding-top:8px;font-size:17px;font-weight:700;line-height:1.3;color:#000000;">{{reservation.vehicle.brand }}</div>
                    <div style="padding-top:2px;font-size:13px;color:#555555;">Année. {{reservation.vehicle.year }} &middot; {{reservation.vehicle.immatriculation }}</div>
                    <div style="padding-top:8px;font-size:13px;line-height:1.7;color:#000000;">
                      {{reservation.vehicle.category }},  {{reservation.vehicle.fuel.label }},  {{reservation.vehicle.transmission }}<br>
                      Mise en circulation : {{reservation.vehicle.datePremiereMiseEnCirculation }}<br>
                      {{reservation.vehicle.mileage|number_format(0,' ',' ') }}&nbsp;km &middot; {{reservation.vehicle.color }}
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Récapitulatif financier -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Récapitulatif</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #E6E3DC;">
                <tr>
                  <td style="padding:12px 0;border-bottom:1px solid #E6E3DC;font-size:14px;color:#555555;">Prix du véhicule</td>
                  <td align="right" style="padding:12px 0;border-bottom:1px solid #E6E3DC;font-size:14px;font-weight:600;color:#000000;white-space:nowrap;">{{reservation.vehicle.price|number_format(2,',',' ') }}&nbsp;€</td>
                </tr>
                <tr>
                  <td style="padding:12px 0;border-bottom:1px solid #E6E3DC;font-size:14px;color:#555555;">Acompte à verser maintenant (20 %)</td>
                  <td align="right" style="padding:12px 0;border-bottom:1px solid #E6E3DC;font-size:14px;font-weight:600;color:#000000;white-space:nowrap;">{{reservation.reservationFeeAmount|number_format(2,',',' ') }}&nbsp;€</td>
                </tr>
                <tr>
                  <td bgcolor="#f5f7f9" style="padding:14px 12px;background:#f5f7f9;font-size:15px;font-weight:700;color:#000000;">Reste à payer après l'acompte</td>
                  <td bgcolor="#f5f7f9" align="right" style="padding:14px 12px;background:#f5f7f9;font-size:18px;font-weight:700;color:#ED1719;white-space:nowrap;">{{(reservation.vehiclePriceSnapshot - reservation.reservationFeeAmount)|number_format(2,',',' ')}} &nbsp;€</td>
                </tr>
              </table>
              <p style="margin:10px 0 0;font-size:12px;line-height:1.6;color:#555555;">
                L'acompte est déduit du prix final. Les modalités de règlement du solde vous seront communiquées par notre équipe.
              </p>
            </td>
          </tr>

          <!-- Coordonnées bancaires (RIB) -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Coordonnées bancaires pour le virement</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6E3DC;">
                <tr>
                  <td colspan="2" bgcolor="#000000" style="background:#000000;padding:12px 14px;font-size:14px;font-weight:700;color:#FFFFFF;">
                    Montant à virer : {{reservation.reservationFeeAmount|number_format(2,',',' ') }}&nbsp;€
                  </td>
                </tr>
                <tr>
                  <td width="38%" valign="top" style="padding:11px 14px;font-size:12px;line-height:1.5;color:#555555;border-bottom:1px solid #E6E3DC;">Bénéficiaire</td>
                  <td valign="top" style="padding:11px 14px;font-size:14px;line-height:1.5;font-weight:700;color:#000000;border-bottom:1px solid #E6E3DC;">{{site_setting('bank_holder')}}</td>
                </tr>
                <tr>
                  <td width="38%" valign="top" style="padding:11px 14px;font-size:12px;line-height:1.5;color:#555555;border-bottom:1px solid #E6E3DC;">Banque</td>
                  <td valign="top" style="padding:11px 14px;font-size:14px;line-height:1.5;font-weight:700;color:#000000;border-bottom:1px solid #E6E3DC;">{{site_setting('bank_name') }}</td>
                </tr>
                <tr>
                  <td width="38%" valign="top" style="padding:11px 14px;font-size:12px;line-height:1.5;color:#555555;border-bottom:1px solid #E6E3DC;">IBAN</td>
                  <td valign="top" style="padding:11px 14px;font-size:14px;line-height:1.5;font-weight:700;color:#000000;border-bottom:1px solid #E6E3DC;"><span style="letter-spacing:1px;">
                   {{site_setting('bank_iban') }}</span></td>
                </tr>
                <tr>
                  <td width="38%" valign="top" style="padding:11px 14px;font-size:12px;line-height:1.5;color:#555555;border-bottom:1px solid #E6E3DC;">BIC</td>
                  <td valign="top" style="padding:11px 14px;font-size:14px;line-height:1.5;font-weight:700;color:#000000;border-bottom:1px solid #E6E3DC;">{{site_setting('bank_bic') }}</td>
                </tr>
                <tr>
                  <td width="38%" valign="top" bgcolor="#FFF6D6" style="background:#FFF6D6;padding:11px 14px;font-size:12px;line-height:1.5;color:#555555;">Motif du virement<br>(obligatoire)</td>
                  <td valign="top" bgcolor="#FFF6D6" style="background:#FFF6D6;padding:11px 14px;font-size:14px;line-height:1.5;font-weight:700;color:#000000;">{{reservation.reservationNumber }}</td>
                </tr>
              </table>
              <p style="margin:10px 0 0;font-size:12px;line-height:1.6;color:#555555;">
                Indiquez impérativement le numéro du bon en motif du virement : sans lui, nous ne pourrons pas rattacher votre paiement à votre réservation.
                Vous préférez payer par carte ? <a href="{{path('reservation_pay',{uuid:reservation.uuid})}}" style="color:#C81214;text-decoration:underline;">Régler l'acompte en ligne</a>.
              </p>
              <p style="margin:10px 0 0;font-size:12px;line-height:1.6;color:#555555;">
                <strong style="color:#000000;">Sécurité :</strong> AutoPro ne vous demandera jamais de modifier ces coordonnées bancaires par e-mail ou par téléphone.
                En cas de doute, contactez-nous avant tout virement.
              </p>
            </td>
          </tr>

          <!-- Informations importantes -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6E3DC;border-left:4px solid #FFCC00;background:#FFFBEA;">
                <tr>
                  <td bgcolor="#FFFBEA" style="padding:16px 18px;background:#FFFBEA;">
                    <p style="margin:0 0 8px;font-size:15px;font-weight:700;color:#000000;">Informations importantes</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="14" valign="top" style="padding:4px 0;font-size:14px;line-height:1.6;color:#ED1719;font-weight:700;">&bull;</td>
                    <td valign="top" style="padding:4px 0;font-size:13px;line-height:1.6;color:#000000;">Le montant de la réservation sera <strong>déduit du prix total</strong> du véhicule.</td>
                  </tr>
                  <tr>
                    <td width="14" valign="top" style="padding:4px 0;font-size:14px;line-height:1.6;color:#ED1719;font-weight:700;">&bull;</td>
                    <td valign="top" style="padding:4px 0;font-size:13px;line-height:1.6;color:#000000;">Ce paiement nous permet de garantir votre intention d'achat et de <strong>réserver le véhicule exclusivement pour vous</strong> jusqu'à votre visite.</td>
                  </tr>
                  <tr>
                    <td width="14" valign="top" style="padding:4px 0;font-size:14px;line-height:1.6;color:#ED1719;font-weight:700;">&bull;</td>
                    <td valign="top" style="padding:4px 0;font-size:13px;line-height:1.6;color:#000000;">Virement instantané, ou votre virement pourra prendre <strong>jusqu'à 4 jours ouvrés</strong>. Votre banque peut nécessiter jusqu'à 48 h pour valider votre bénéficiaire.</td>
                  </tr>
                  <tr>
                    <td width="14" valign="top" style="padding:4px 0;font-size:14px;line-height:1.6;color:#ED1719;font-weight:700;">&bull;</td>
                    <td valign="top" style="padding:4px 0;font-size:13px;line-height:1.6;color:#000000;">Un <strong>remboursement intégral</strong> est possible en cas de non-conclusion de la vente.</td>
                  </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Vos informations + livraison -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Vos informations</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #E6E3DC;">
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Nom</div>
                    <div style="font-size:14px;font-weight:600;color:#000000;">{{reservation.customerName }}</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Téléphone</div>
                    <div style="font-size:14px;font-weight:600;color:#000000;">{{reservation.customerPhone}}</div>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">E-mail</div>
                    <div style="font-size:14px;font-weight:600;color:#000000;">{{reservation.customerEmail }}</div>
                  </td>
                </tr>
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Mode de réception</div>
                    {% if reservation.receptionMode.value == 'PICKUP' %}
                    <div style="font-size:14px;font-weight:600;color:#000000;">Retrait au garage</div>
                    {% else %}
                     <div style="font-size:14px;font-weight:600;color:#000000;">Livraison à domicile</div>
                    {% endif %}
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    {% if reservation.receptionMode.value == 'PICKUP' %}
                      <div style="font-size:12px;color:#555555;">Date/Heure de retrait</div>
                      <div style="font-size:14px;font-weight:600;line-height:1.5;color:#000000;">{{ reservation.pickupDate|date('d/m/Y') }} à {{ reservation.pickupTime }}</div>
                    {% else %}
                      <div style="font-size:12px;color:#555555;">Adresse de livraison</div>
                      <div style="font-size:14px;font-weight:600;line-height:1.5;color:#000000;">{{ reservation.deliveryAddress }}, {{ reservation.deliveryPostalCode }} {{ reservation.deliveryCity }}</div>
                    {% endif %}
                    </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Prochaines étapes -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Prochaines étapes</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="28" valign="top" style="padding:6px 0;"><span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:11px;background:#000000;color:#ffffff;font-size:12px;font-weight:700;">1</span></td>
                  <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Effectuez le virement de l'acompte en indiquant le numéro du bon en motif.</td>
                </tr>
                <tr>
                  <td width="28" valign="top" style="padding:6px 0;"><span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:11px;background:#000000;color:#ffffff;font-size:12px;font-weight:700;">2</span></td>
                  <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Dès réception, nous confirmons votre réservation par e-mail et le véhicule est retiré de la vente.</td>
                </tr>
                <tr>
                  <td width="28" valign="top" style="padding:6px 0;"><span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:11px;background:#000000;color:#ffffff;font-size:12px;font-weight:700;">3</span></td>
                   {% if reservation.receptionMode.value == 'PICKUP' %}
                       <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Vous pouvez dès à présent passer au  garage pour récupérer votre véhicule</td>
                    {% else %}
                        <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Le transporteur convient avec vous d'un créneau d'une heure. Livraison en 3 jours en moyenne.</td>
                     {% endif %}
                 </tr>
              </table>
            </td>
          </tr>

          <!-- Vos droits -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f9;border:1px solid #E6E3DC;">
                <tr>
                  <td style="padding:16px 18px;">
                    <p style="margin:0 0 6px;font-size:14px;font-weight:700;color:#000000;">Vos droits</p>
                    <p style="margin:0;font-size:13px;line-height:1.6;color:#555555;">
                      Vous disposez de <strong style="color:#000000;">14 jours à compter de la livraison</strong> pour vous rétracter.
                      Une fois versé, l'acompte est remboursable si le véhicule ne correspond plus à vos attentes : faites votre demande en cliquant sur le bouton "Demander un remboursement" dans l'email ou contactez-nous.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Boutons -->
          <tr>
            <td class="px" align="center" style="padding:32px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0" width="320" style="width:320px;max-width:100%;">
                <tr>
                  <td align="center" bgcolor="#000000" style="background:#000000;border:2px solid #000000;border-radius:6px;">
                    <a href="{{ url('reservation_confirmation', {uuid: reservation.uuid}) }}" target="_blank" style="display:block;padding:14px 20px;font-family:Verdana,Geneva,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Voir ma réservation</a>
                  </td>
                </tr>
                <tr><td height="10" style="height:10px;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr>
                  <td align="center" bgcolor="#FFFFFF" style="background:#FFFFFF;border:2px solid #000000;border-radius:6px;">
                    <a href="{{ url('reservation_release_funds', {uuid: reservation.uuid}) }}" target="_blank" style="display:block;padding:14px 20px;font-family:Verdana,Geneva,sans-serif;font-size:15px;font-weight:bold;color:#000000;text-decoration:none;">Demander un remboursement</a>
                  </td>
                </tr>
                <tr><td height="10" style="height:10px;font-size:0;line-height:0;">&nbsp;</td></tr>
                <tr>
                  <td align="center" bgcolor="#ED1719" style="background:#ED1719;border:2px solid #ED1719;border-radius:6px;">
                    <a href="{{ url('reservation_payment_proof', {uuid: reservation.uuid}) }}" target="_blank" style="display:block;padding:14px 20px;font-family:Verdana,Geneva,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;">Envoyer la preuve de paiement</a>
                  </td>
                </tr>
              </table>
              <p style="margin:14px 0 0;font-size:13px;">
                <a href="#" style="color:#C81214;text-decoration:underline;">Télécharger le bon de réservation (PDF)</a>
              </p>
            </td>
          </tr>

          <!-- Contact -->
          <tr>
            <td class="px" style="padding:24px 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #E6E3DC;">
                <tr>
                  <td style="padding-top:20px;font-size:14px;line-height:1.6;color:#555555;">
                    Une question sur votre réservation ? Répondez simplement à cet e-mail ou appelez-nous au
                    <strong style="color:#000000;">{{site_setting('company_phone') }}</strong>.<br>
                    Pensez à rappeler votre numéro de bon : <strong style="color:#000000;">{{reservation.reservationNumber }}</strong>.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ===== FOOTER ===== -->
          <tr>
            <td class="px" align="center" bgcolor="#000000" style="background:#000000;padding:30px 32px;">
              <span style="font-family:Verdana,Geneva,sans-serif;font-size:22px;font-weight:700;letter-spacing:1px;color:#FFFFFF;">AUTO<span style="color:#ED1719;">PRO</span></span>

              <p style="margin:18px 0 0;font-size:13px;line-height:2;color:#999999;">
                <a download href="{{asset('documents/mentions_legales_autopro_express.pdf')}}" style="color:#FFFFFF;text-decoration:underline;">Mentions légales</a>
                &nbsp;|&nbsp;
                <a download href="{{asset('documents/politique_confidentialite_autopro_express.pdf')}}" style="color:#FFFFFF;text-decoration:underline;">Politique de confidentialité</a>
