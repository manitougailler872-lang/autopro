<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Contrat de vente AutoPro Express</title>
    </head>
    <body
        style="
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            font-family: Arial, Helvetica, sans-serif;
            color: #222222;
        "
    >
        <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="background-color: #f5f5f5"
        >
            <tr>
                <td align="center" style="padding: 30px 15px">
                    <table
                        role="presentation"
                        width="600"
                        cellspacing="0"
                        cellpadding="0"
                        border="0"
                        style="
                            width: 100%;
                            max-width: 600px;
                            background: #ffffff;
                            border-radius: 10px;
                            overflow: hidden;
                        "
                    >
                        <!-- HEADER -->
                        <tr>
                            <td align="center" style="padding: 25px 20px; ">
                                <img
                                  src="https://luxecar-automobile-reservation.fr/images/logo.png"
                                  alt="{{site_setting('company_name')}}"
                                    width="190"
                                    style="display: block; border-radius:20px;width: 190px; max-width: 100%; height: auto; border: 0"
                                />
                            </td>
                        </tr>

                        <!-- CONTENT -->
                        <tr>
                            <td style="padding: 35px 35px 20px 35px; font-size: 15px; line-height: 1.6">
                                <p style="margin: 0 0 20px 0">Bonjour  {{reservation.customerName}},</p>
                                <p style="margin: 0 0 20px 0">
                                    Veuillez trouver ci-joint votre
                                    <strong>contrat de vente concernant le véhicule {{reservation.vehicle.brand}}</strong>.
                                </p>
                                <p style="margin: 0 0 20px 0">
                                    Merci de bien vouloir
                                    <strong
                                        >télécharger le contrat, compléter les informations demandées et le
                                        signer.</strong
                                    >
                                </p>
                                <p style="margin: 0 0 20px 0">
                                    Une fois le document complété et signé, merci de nous le retourner par e-mail.
                                </p>
                              
                                <p style="margin: 30px 0 0 0">
                                    Cordialement,<br />
                                    <strong style="color: #C98800"> L'équipe {{site_setting('company_name')}} </strong>
                                </p>
                            </td>
                        </tr>
                        <!-- FOOTER -->
                        <tr>
                            <td
                                align="center"
                                style="
                                    padding: 20px;
                                    background: #f2f2f2;
                                    color: #777777;
                                    font-size: 12px;
                                    line-height: 1.5;
                                "
                            >
                                {{site_setting('company_name')}}<br />
                                {{site_setting('company_address')}}<br />
                                <br />

                                <a
                                    href="mailto:garage@autopro-reservation.fr"
                                    style="color: #C98800; text-decoration: none"
                                >
                                    {{site_setting('company_email')}}
                                </a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>