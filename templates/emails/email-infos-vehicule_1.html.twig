<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Informations complémentaires sur votre véhicule - AutoPro</title>
  <style>
    body { margin:0; padding:0; background:#f5f7f9; -webkit-text-size-adjust:100%; }
    table { border-collapse:collapse; }
    body, table, td, p, div, a { font-family:Verdana,Geneva,sans-serif; }
    img { border:0; outline:none; text-decoration:none; }
    a { color:#C81214; }
    @media (max-width: 620px) {
      .container { width:100% !important; }
      .px { padding-left:20px !important; padding-right:20px !important; }
      .col { display:block !important; width:100% !important; }
      .h1 { font-size:22px !important; }
      .price { font-size:26px !important; }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:#f5f7f9;font-family:Verdana,Geneva,sans-serif;color:#000000;">

  <!-- Texte d'aperçu (visible dans la boîte de réception, masqué dans le mail) -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px;color:#f5f7f9;">
    Fiche détaillée, équipements et conditions de réservation de votre véhicule.
  </div>

  <!-- ===== EN-TETE DE MAQUETTE (à retirer en production) ===== -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#e9edf1;">
    <tr>
      <td align="center" style="padding:14px 16px;font-family:Verdana,Geneva,sans-serif;font-size:12px;color:#555555;line-height:1.6;">
        <strong>De :</strong> AutoPro &lt;noreply@autopro-reservation.fr&gt; &nbsp;|&nbsp;
        <strong>Objet :</strong> Votre demande d'informations : {{ vehicle.brand }}, réf. {{ vehicle.originNumber}}
      </td>
    </tr>
  </table>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f9;">
    <tr>
      <td align="center" style="padding:24px 12px 40px;">

        <!-- ===== CONTENEUR 600px ===== -->
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#FFFFFF;border:1px solid #E6E3DC;font-family:Verdana,Geneva,sans-serif;">

          <!-- Logo -->
          <tr>
            <td class="px" align="center" style="padding:22px 32px;border-top:4px solid #ED1719;border-bottom:1px solid #E6E3DC;">
              <!-- Remplace par : <img src="https://.../logo-autopro.png" width="150" alt="AutoPro"> -->
              <span style="font-family:Verdana,Geneva,sans-serif;font-size:26px;font-weight:700;letter-spacing:1px;color:#000000;">AUTO<span style="color:#ED1719;">PRO</span></span>
            </td>
          </tr>

          <!-- Introduction -->
          <tr>
            <td class="px" style="padding:32px 32px 8px;">
              <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#000000;">Bonjour {{ gender }},</p>
              <p style="margin:0;font-size:15px;line-height:1.6;color:#555555;">
                Suite à votre demande, voici les informations complémentaires sur le véhicule qui vous intéresse.
                Vous y trouverez la fiche détaillée, les équipements et les modalités de réservation.
              </p>
            </td>
          </tr>

          <!-- Photo principale -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <a href="#" style="text-decoration:none;">
                <img src="{{site_setting('company_site') }}/uploads/vehicles/{{vehicle.getPrimaryImage().filename}}"
                     width="536" alt="Photo principale du véhicule" style="display:block;width:100%;height:auto;border:0;border-radius:12px;">
              </a>
            </td>
          </tr>

         {% if vehicle.imagesMail is not empty and vehicle.imagesMail|length == 4 %}
          <!-- Miniatures -->
          <tr>
            <td class="px" style="padding:6px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="33%" style="padding-right:3px;">
                    <img src="{{site_setting('company_site') }}/uploads/vehicles/mail/{{vehicle.imagesMail[0].filename}}" width="170" alt="Vue avant" style="display:block;width:100%;height:auto;border-radius:8px;">
                  </td>
                  <td width="34%" style="padding:0 3px;">
                    <img src="{{site_setting('company_site') }}/uploads/vehicles/mail/{{vehicle.imagesMail[1].filename}}" width="170" alt="Vue de profil" style="display:block;width:100%;height:auto;border-radius:8px;">
                  </td>
                  <td width="33%" style="padding-left:3px;">
                    <img src="{{site_setting('company_site') }}/uploads/vehicles/mail/{{vehicle.imagesMail[2].filename}}" width="170" alt="Jante" style="display:block;width:100%;height:auto;border-radius:8px;">
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {%  endif  %}

          <!-- Titre + prix -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <span style="display:inline-block;background:#FFCC00;color:#000000;font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;padding:4px 10px;">Occasion</span>
                    <span style="font-size:12px;color:#555555;padding-left:8px;">Réf. {{ vehicle.originNumber }}</span>
                  </td>
                </tr>
                <tr>
                  <td class="h1" style="padding-top:10px;font-size:26px;line-height:1.25;font-weight:700;color:#000000;">
                    {{ vehicle.brand }}
                  </td>
                </tr>
                <tr>
                  <td style="padding-top:4px;font-size:14px;color:#555555;">{{ vehicle.category }}, {{ vehicle.fuel.label() }}, boîte {{ vehicle.transmission }}, {{ vehicle.places }} places</td>
                </tr>
                <tr>
                  <td class="price" style="padding-top:12px;font-size:32px;line-height:1.1;font-weight:700;color:#ED1719;">{{ vehicle.price }} €</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Description -->
          <tr>
            <td class="px" style="padding:24px 32px 0;">
              <p style="margin:0;font-size:14px;line-height:1.7;color:#555555;">
                {{ vehicle.description }}
              </p>
            </td>
          </tr>

          <!-- Caractéristiques -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Caractéristiques</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #E6E3DC;">
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Référence</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.originNumber }}</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Immatriculation</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.immatriculation }}</div>
                  </td>
                </tr>
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">VIN</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.vim }}</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Catégorie</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.category }}</div>
                  </td>
                </tr>
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Mise en circulation</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.datePremiereMiseEnCirculation }}</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Kilométrage</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.mileage }} km</div>
                  </td>
                </tr>
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Énergie</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.fuel.label()|capitalize }}</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Boîte de vitesses</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.transmission|capitalize }}</div>
                  </td>
                </tr>
                <tr>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Carrosserie</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.places }} places / {{ vehicle.doors }} portes</div>
                  </td>
                  <td class="col" width="50%" valign="top" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Couleur</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.color|capitalize }}</div>
                  </td>
                </tr>
                <tr>
                  <td colspan="2" style="padding:12px 0;border-bottom:1px solid #E6E3DC;">
                    <div style="font-size:12px;color:#555555;">Puissance</div>
                    <div style="font-size:15px;font-weight:600;color:#000000;">{{ vehicle.power }} kW / 299 ch / 16 cv</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

           {% if vehicle.historiqueMail is not empty %}
                            {% set histories = vehicle.historiqueMail|split('|') %}

          <!-- Historique d'entretien -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Historique d'entretien</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6E3DC;">
                <tr style="background:#f5f7f9;">
                  <td bgcolor="#f5f7f9" style="padding:10px 12px;font-size:12px;font-weight:700;color:#555555;border-bottom:1px solid #E6E3DC;">Date</td>
                  <td bgcolor="#f5f7f9" style="padding:10px 12px;font-size:12px;font-weight:700;color:#555555;border-bottom:1px solid #E6E3DC;">Kilométrage</td>
                  <td bgcolor="#f5f7f9" style="padding:10px 12px;font-size:12px;font-weight:700;color:#555555;border-bottom:1px solid #E6E3DC;">Interventions</td>
                </tr>
                 {% for h in histories %}
                      {% set data = h|split(';') %}
                <tr>
                  <td valign="top" style="padding:10px 12px;font-size:13px;line-height:1.5;color:#000000;white-space:nowrap;border-bottom:1px solid #E6E3DC;">{{ data[0] }}</td>
                  <td valign="top" style="padding:10px 12px;font-size:13px;line-height:1.5;color:#000000;white-space:nowrap;border-bottom:1px solid #E6E3DC;">{{ data[1] }}</td>
                  <td valign="top" style="padding:10px 12px;font-size:13px;line-height:1.5;color:#000000;border-bottom:1px solid #E6E3DC;">{{ data[2] }}</td>
                </tr>
                         {% endfor %}
              </table>
            </td>
          </tr>
   {% endif %}
            <!-- Photos et documents -->
          {% if vehicle.imagesPlus is not empty %}
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Photos et documents</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E6E3DC;">
                <tr>
                  <td style="padding:14px 16px;border-bottom:1px solid #E6E3DC;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td valign="middle">
                          <a target="_blank"  href="{{url('vehicle_photo_supplementaire',{slug:vehicle.slug})}}" style="font-size:15px;font-weight:700;color:#000000;text-decoration:none;">Photos supplémentaires</a>
                          <div style="padding-top:2px;font-size:13px;line-height:1.5;color:#555555;">{{ vehicle.imagesPlus|length + vehicle.images|length  }} photos : intérieur, coffre, moteur et détails</div>
                        </td>
                        <td valign="middle" align="right" width="110" style="white-space:nowrap;">
                          <a  target="_blank" href="{{url('vehicle_photo_supplementaire',{slug:vehicle.slug})}}" style="font-size:13px;font-weight:600;color:#C81214;text-decoration:none;">Voir &rsaquo;</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                 {% endif  %}
                {% if vehicle.ctFile is not empty %}
                  <tr>
                    <td style="padding:14px 16px;border-bottom:1px solid #E6E3DC;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td valign="middle">
                            <a  target="_blank"  href="{{site_setting('company_site')}}/uploads/ct/{{vehicle.ctFile}}" style="font-size:15px;font-weight:700;color:#000000;text-decoration:none;">Contrôle technique</a>
                            <div style="padding-top:2px;font-size:13px;line-height:1.5;color:#555555;">Procès-verbal du contrôle technique</div>
                          </td>
                          <td valign="middle" align="right" width="110" style="white-space:nowrap;">
                            <a  target="_blank" href="{{site_setting('company_site')}}/uploads/ct/{{vehicle.ctFile}}" style="font-size:13px;font-weight:600;color:#C81214;text-decoration:none;">Voir &rsaquo;</a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                {% endif  %}
                <tr>
                  <td style="padding:14px 16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td valign="middle">
                          <a  target="_blank"  href="{{url('vehicle_rapport',{slug:vehicle.slug})}}" style="font-size:15px;font-weight:700;color:#000000;text-decoration:none;">Rapport d'entretien</a>
                          <div style="padding-top:2px;font-size:13px;line-height:1.5;color:#555555;">Historique des révisions et des interventions</div>
                        </td>
                        <td valign="middle" align="right" width="110" style="white-space:nowrap;">
                          <a  target="_blank"  href="{{url('vehicle_rapport',{slug:vehicle.slug})}}" style="font-size:13px;font-weight:600;color:#C81214;text-decoration:none;">Voir &rsaquo;</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Nos engagements -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f9;border:1px solid #E6E3DC;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 12px;font-size:16px;font-weight:700;color:#000000;">Nos engagements</p>
                    <div style="font-size:14px;line-height:1.5;color:#000000;padding:4px 0;"><strong>13 points de contrôle</strong> minimum avant la mise en vente</div>
                    <div style="font-size:14px;line-height:1.5;color:#000000;padding:4px 0;"><strong>Garantie de 6 à 12 mois</strong> sur chaque véhicule</div>
                    <div style="font-size:14px;line-height:1.5;color:#000000;padding:4px 0;"><strong>Livraison en 3 jours</strong> en moyenne, sur un créneau d'une heure</div>
                    <div style="font-size:14px;line-height:1.5;color:#000000;padding:4px 0;"><strong>14 jours</strong> pour vous rétracter après la livraison</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Comment réserver -->
          <tr>
            <td class="px" style="padding:28px 32px 0;">
              <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#000000;">Comment réserver ?</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="28" valign="top" style="padding:6px 0;"><span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:11px;background:#000000;color:#ffffff;font-size:12px;font-weight:700;">1</span></td>
                  <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Cliquez sur « Réserver » et renseignez vos coordonnées.</td>
                </tr>
                <tr>
                  <td width="28" valign="top" style="padding:6px 0;"><span style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:11px;background:#000000;color:#ffffff;font-size:12px;font-weight:700;">3</span></td>
                  <td style="padding:6px 0;font-size:14px;line-height:1.5;color:#000000;">Recevez votre véhicule à domicile ou retirez-le au garage.</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Bouton -->
          <tr>
            <td class="px" align="center" style="padding:32px 32px 8px;">
              <!-- Bouton animé (GIF). En production : URL absolue https, ex. https://www.autopro-reservation.fr/images/email/btn-reserver.gif -->
              <table role="presentation" cellpadding="0" cellspacing="0" width="320" style="width:320px;max-width:100%;">
                <tr>
                  <td align="center" valign="middle" width="320" height="56" bgcolor="#ED1719" style="background:#ED1719;border-radius:6px;">
                         <a target="_blank" href="{{path('vehicle_detail',{slug:vehicle.slug})}}" style="display:inline-block;padding:15px 34px;font-family:Verdana,Arial,Helvetica,sans-serif;font-size:16px;font-weight:600;color:#FFFFFF;text-decoration:none;">Réserver ce véhicule</a>
                  </td>
                </tr>
              </table>
              <p style="margin:14px 0 0;font-size:13px;">
                <a href="{{path('vehicle_detail',{slug:vehicle.slug})}}" style="color:#C81214;text-decoration:underline;">Voir la fiche complète sur le site</a>
              </p>
            </td>
          </tr>

          <!-- Contact -->
          <tr>
            <td class="px" style="padding:24px 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #E6E3DC;">
                <tr>
                  <td style="padding-top:20px;font-size:14px;line-height:1.6;color:#555555;">
                    Une question sur ce véhicule ? Répondez simplement à cet e-mail ou appelez-nous au
                    <strong style="color:#000000;"> {{site_setting('company_phone') }}</strong>.<br>
                    Notre équipe vous répond du lundi au samedi.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ===== FOOTER ===== -->
          <tr>
            <td class="px" align="center" bgcolor="#000000" style="background:#000000;padding:30px 32px;">
              <span style="font-family:Verdana,Geneva,sans-serif;font-size:22px;font-weight:700;letter-spacing:1px;color:#FFFFFF;">AUTO<span style="color:#ED1719;">PRO</span></span>

              <p style="margin:18px 0 0;font-size:13px;line-height:2;color:#999999;">
                <a href="#" style="color:#FFFFFF;text-decoration:underline;">Mentions légales</a>
                &nbsp;|&nbsp;
                <a href="#" style="color:#FFFFFF;text-decoration:underline;">Politique de confidentialité</a>
                &nbsp;|&nbsp;
                <a href="#" style="color:#FFFFFF;text-decoration:underline;">Politique de livraison</a>
              </p>

              <p style="margin:16px 0 0;font-size:12px;line-height:1.7;color:#B5B5B5;">
                Vous recevez cet e-mail suite à votre demande d'informations sur
                <a href="#" style="color:#FFFFFF;text-decoration:underline;">{{site_setting('company_site') }}</a>.<br>
              </p>

              <p style="margin:14px 0 0;font-size:12px;line-height:1.7;color:#B5B5B5;">
                AutoPro,{{site_setting('company_registration') }}<br>
                {{site_setting('company_address') }}
              </p>
            </td>
          </tr>

        </table>
        <!-- ===== FIN CONTENEUR ===== -->

      </td>
    </tr>
  </table>

</body>
</html>
