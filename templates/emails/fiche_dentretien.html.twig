<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Rapport d'entretien véhicule - {{vehicle.brand}}</title>
        <style>
            @page {
                size: A4;
                margin: 10mm;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: #eef2f6;
                color: #172033;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 12px;
            }
            .page {
                width: 210mm;
                min-height: 297mm;
                margin: 14px auto;
                background: #fff;
                padding: 12mm 12mm 10mm;
                box-shadow: 0 8px 30px rgba(16, 24, 40, 0.1);
                page-break-after: always;
            }
            .page:last-child {
                page-break-after: auto;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 3px solid #333;
                padding-bottom: 7mm;
                margin-bottom: 6mm;
            }
            .brand img {
                width: 44mm;
                height: auto;
                display: block;
            }
            .title-block {
                text-align: right;
            }
            h1 {
                margin: 0;
                font-size: 25px;
                line-height: 1.05;
                color: #333;
                letter-spacing: 0.2px;
            }
            .subtitle {
                margin-top: 5px;
                color: #6b7280;
                font-size: 11px;
            }
            .meta-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 8px;
                margin-bottom: 6mm;
            }
            .meta {
                border: 1px solid #d9e1ec;
                border-radius: 7px;
                padding: 8px 10px;
                min-height: 52px;
                background: #fbfcfe;
            }
            .meta .label {
                display: block;
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #6b7280;
                margin-bottom: 5px;
            }
            .meta .value {
                font-weight: 700;
                font-size: 12px;
                color: #111827;
            }
            .section {
                margin-top: 5mm;
            }
            .section-title {
                background: #000;
                color: white;
                font-size: 13px;
                font-weight: 700;
                padding: 7px 10px;
                border-radius: 6px 6px 0 0;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #d8e0ea;
            }
            th,
            td {
                padding: 6px 8px;
                border-bottom: 1px solid #e5eaf1;
                vertical-align: middle;
            }
            th {
                width: 38%;
                background: #f6f8fb;
                text-align: left;
                color: #344054;
                font-weight: 600;
            }
            td {
                color: #111827;
            }
            tr:last-child th,
            tr:last-child td {
                border-bottom: 0;
            }
            .status {
                display: inline-block;
                min-width: 58px;
                text-align: center;
                border-radius: 999px;
                padding: 3px 8px;
                font-size: 10px;
                font-weight: 700;
                border: 1px solid #cfe0f8;
                background: #edf5ff;
                color: #333;
            }
            .status.good {
                color: #166534;
                border-color: #bbdfc5;
                background: #f0fdf4;
            }
            .status.warn {
                color: #92400e;
                border-color: #f2d29e;
                background: #fff7e8;
            }
            .status.changed {
                color: #7c2d12;
                border-color: #f3c6b5;
                background: #fff4ef;
            }
            .two-col {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .check-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 7px 18px;
                border: 1px solid #d8e0ea;
                padding: 10px;
                border-radius: 0 0 7px 7px;
            }
            .check {
                display: flex;
                gap: 7px;
                align-items: center;
            }
            .box {
                width: 14px;
                height: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #617085;
                font-size: 10px;
                font-weight: bold;
                background: #fff;
            }
            .signatures {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 6mm;
            }
            .signature-card {
                border: 1px solid #d8e0ea;
                border-radius: 8px;
                padding: 10px;
            }
            .signature-card h3 {
                color: #333;
                margin: 0 0 8px;
                font-size: 12px;
            }
            .signature-img {
                width: 100%;
                height: 42mm;
                object-fit: contain;
                background: #fff;
                border: 1px solid #e3e8ef;
                border-radius: 5px;
            }
            .note {
                margin-top: 5mm;
                padding: 9px 11px;
                border-left: 3px solid #333;
                background: #f6f9fd;
                color: #475467;
                line-height: 1.45;
                font-size: 10px;
            }
            .footer {
                margin-top: 5mm;
                padding-top: 4mm;
                border-top: 1px solid #d8e0ea;
                display: flex;
                justify-content: space-between;
                color: #667085;
                font-size: 9px;
            }
            @media print {
                body {
                    background: #fff;
                }
                .page {
                    margin: 0;
                    box-shadow: none;
                }
            }
        </style>
    </head>
    <body>
        <section class="page">
            <div class="header">
                <div class="brand">
                       <img
                            alt="{{site_setting('company_name')}}"
                            src="data:image/png;base64,"
                        />
                </div>
                <div class="title-block">
                    <h1>RAPPORT D'ENTRETIEN VÉHICULE</h1>
                    <div class="subtitle">Compte rendu d'intervention et de contrôle</div>
                </div>
            </div>
            <div class="meta-grid">
                <div class="meta"><span class="label">Véhicule</span><span class="value">{{vehicle.brand }}</span></div>
                <div class="meta"><span class="label">Immatriculation</span><span class="value">{{vehicle.immatriculation}}</span></div>
                <div class="meta"><span class="label">Modèle/Année</span><span class="value">{{vehicle.year}}</span></div>
            
                <div class="meta"><span class="label">Kilométrage</span><span class="value">{{vehicle.mileage}} km</span></div>
                <div class="meta"><span class="label">Type</span><span class="value">{{vehicle.fuel.label}}</span></div>
                <div class="meta">
                    <span class="label">Date / heure entretien</span><span class="value">{{vehicle.dateEntretien}} — {{vehicle.heureEntretien}}</span>
                </div>
            </div>
            <div class="section">
                <div class="section-title">Entretien moteur et filtration</div>
                <table>
                    <tr>
                        <th>Service entretien intermédiaire</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Vidange moteur</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Remplacement filtre à huile</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Remplacement filtre carburant</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Remplacement filtre d'habitacle</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Remplacement filtre à air</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                </table>
            </div>

            <div class="section">
                <div class="section-title">Allumage, préchauffage et injection</div>
                <table>
                    <tr>
                        <th>Bougie allumage</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Bougie de préchauffage</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                </table>
            </div>

            <div class="section">
                <div class="section-title">Boîte de vitesses, pont et fluides</div>
                <table>
                    <tr>
                        <th>Vidange boîte</th>
                        <td>Mis à niveau</td>
                    </tr>
                    <tr>
                        <th>Vidange pont arrière</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
              
                    <tr>
                        <th>Vidange liquide refroidissement</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                
                    <tr>
                        <th>Remplacement / niveau liquide frein</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>Niveau direction assistée</th>
                        <td><span class="status">Oui</span></td>
                    </tr>
                    <tr>
                        <th>DOT niveau / changement</th>
                        <td><span class="status warn">Prévoir le changement</span></td>
                    </tr>
                </table>
            </div>

            <div class="footer">
                <span>{{site_setting('company_name')}} — Fiche entretien</span>
                <span>Page 1 / 2</span>
            </div>
        </section>

        <section class="page">
            <div class="header">
                <div class="brand">
                       <img
                            alt="{{site_setting('company_name')}}"
                            src="data:image/png;base64,"
                        />
                </div>
                <div class="title-block">
                    <h1>CONTRÔLES & REMPLACEMENTS</h1>
                    <div class="subtitle">Suite de la fiche d'entretien — {{vehicle.immatriculation}}</div>
                </div>
            </div>

            <div class="two-col">
                <div class="section">
                    <div class="section-title">Distribution et refroidissement</div>
                    <table>
                        <tr>
                            <th>Courroie d'accessoire</th>
                            <td><span class="status good">Bon état</span></td>
                        </tr>
                        <tr>
                            <th>Courroie distribution</th>
                            <td><span class="status changed">Oui changement</span></td>
                        </tr>
                        <tr>
                            <th>Pompe à eau</th>
                            <td><span class="status good">Bon état</span></td>
                        </tr>
                    </table>
                </div>
                <div class="section">
                    <div class="section-title">Batterie et pneumatiques</div>
                    <table>
                        <tr>
                            <th>Remplacement batterie</th>
                            <td><span class="status changed">Oui remplacement</span></td>
                        </tr>
                        <tr>
                            <th>Test batterie multimètre</th>
                            <td><span class="status good">Bon état</span></td>
                        </tr>
                        <tr>
                            <th>Contrôle pression pneu</th>
                            <td><span class="status">Oui</span></td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Système de freinage</div>
                <table>
                    <tr>
                        <th>Plaquette de frein AV</th>
                        <td><span class="status good">Bon état</span></td>
                    </tr>
                    <tr>
                        <th>Disque de frein AV</th>
                        <td><span class="status changed">Oui changement des disques</span></td>
                    </tr>
                    <tr>
                        <th>Plaquette / tambour AR</th>
                        <td><span class="status good">Bon état</span></td>
                    </tr>
                    <tr>
                        <th>Disque de frein AR</th>
                        <td><span class="status good">Bon état</span></td>
                    </tr>
                </table>
            </div>

            <div class="section">
                <div class="section-title">Visibilité et éclairage</div>
                <table>
                    <tr>
                        <th>Lave glace</th>
                        <td>Mis à niveau</td>
                    </tr>
                    <tr>
                        <th>Balais essuie-glaces</th>
                        <td><span class="status good">Bon état</span></td>
                    </tr>
                </table>
                <div class="check-grid">
                    <div>
                        <strong style="color: #333">Ampoules AV changées</strong>
                        <div class="check" style="margin-top: 8px"><span class="box">✓</span> Feu de croisement</div>
                        <div class="check"><span class="box">✓</span> Feu de route</div>
                        <div class="check"><span class="box">✓</span> Feux clignotants</div>
                        <div class="check"><span class="box">✓</span> Feux de position</div>
                        <div class="check"><span class="box">✓</span> Feux de brouillard avant</div>
                    </div>
                    <div>
                        <strong style="color: #333">Ampoules AR changées</strong>
                        <div class="check" style="margin-top: 8px"><span class="box">✓</span> Feux de stop</div>
                        <div class="check"><span class="box">✓</span> Feux de recul</div>
                        <div class="check"><span class="box">✓</span> Feux clignotants</div>
                        <div class="check"><span class="box">✓</span> Feux de détresse</div>
                        <div class="check"><span class="box">✓</span> Feux de brouillard arrière</div>
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Autre</div>
                <table>
                    <tr>
                        <td style="height: 30px">RAS</td>
                    </tr>
                </table>
            </div>

            <div class="footer">
                <span>{{site_setting('company_name')}} — Fiche entretien véhicule</span>
                <span>Page 2 / 2</span>
            </div>
        </section>
    </body>
</html>