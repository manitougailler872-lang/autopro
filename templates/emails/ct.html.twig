<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Procès-verbal de contrôle technique</title>
        <style>
            @page {
                size: A4;
                margin: 8mm;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: #d7d7d7;
                font-family: Arial, Helvetica, sans-serif;
                color: #111;
            }
            .paper {
                position: relative;
                width: 210mm;
                min-height: 297mm;
                margin: 20px auto;
                padding: 7mm;
                overflow: hidden;
                background: linear-gradient(
                        14deg,
                        rgba(0, 0, 0, 0.05) 0 1px,
                        transparent 1px 48%,
                        rgba(255, 255, 255, 0.55) 49%,
                        transparent 51%
                    ),
                    linear-gradient(
                        103deg,
                        transparent 0 45%,
                        rgba(0, 0, 0, 0.035) 46%,
                        rgba(255, 255, 255, 0.55) 48%,
                        transparent 50%
                    ),
                    radial-gradient(ellipse at 28% 18%, rgba(0, 0, 0, 0.055), transparent 26%),
                    radial-gradient(ellipse at 70% 42%, rgba(255, 255, 255, 0.7), transparent 28%),
                    radial-gradient(ellipse at 36% 74%, rgba(0, 0, 0, 0.04), transparent 25%), #f4f2eb;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
            }
            .paper:before,
            .paper:after {
                content: "";
                position: absolute;
                inset: -10%;
                pointer-events: none;
            }
            .paper:before {
                background: linear-gradient(
                        79deg,
                        transparent 0 36%,
                        rgba(0, 0, 0, 0.06) 37%,
                        rgba(255, 255, 255, 0.72) 38.5%,
                        transparent 40%
                    ),
                    linear-gradient(
                        165deg,
                        transparent 0 54%,
                        rgba(0, 0, 0, 0.05) 55%,
                        rgba(255, 255, 255, 0.6) 56.5%,
                        transparent 58%
                    ),
                    linear-gradient(
                        8deg,
                        transparent 0 67%,
                        rgba(0, 0, 0, 0.045) 68%,
                        rgba(255, 255, 255, 0.55) 69.4%,
                        transparent 71%
                    );
                opacity: 0.75;
                mix-blend-mode: multiply;
            }
            .paper:after {
                background: radial-gradient(
                        ellipse at 54% 48%,
                        transparent 0 12%,
                        rgba(0, 0, 0, 0.025) 14%,
                        transparent 17%
                    ),
                    radial-gradient(ellipse at 20% 86%, transparent 0 10%, rgba(0, 0, 0, 0.03) 12%, transparent 16%);
            }

            .top {
                display: grid;
                grid-template-columns: 1fr 1.7fr 1fr;
                align-items: start;
                gap: 6px;
                position: relative;
                z-index: 1;
            }
            .barcode-wrap {
                font-size: 10px;
            }
            .barcode {
                width: 48mm;
                height: 12mm;
                margin: 0 auto 2mm;
                background: repeating-linear-gradient(
                    90deg,
                    #111 0 1px,
                    transparent 1px 2px,
                    #111 2px 4px,
                    transparent 4px 6px,
                    #111 6px 7px,
                    transparent 7px 10px
                );
            }
            .title {
                text-align: center;
                font-weight: 700;
                letter-spacing: 0.5px;
                font-size: 18px;
                line-height: 1.15;
                margin-top: 6mm;
            }
            .brand {
                text-align: right;
                font-weight: 900;
                font-size: 20px;
                letter-spacing: 1px;
                margin-top: 1mm;
            }
            .brand span {
                display: inline-block;
                color: #111;
            }
            .brand b {
                color: #f0a400;
            }
            .brand small {
                display: block;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.6px;
                margin-top: 2px;
            }

            .row3 {
                display: grid;
                grid-template-columns: 1.2fr 1.2fr 1fr;
                margin-top: 5px;
            }
            .row3 > div {
                border: 1px solid #222;
                background: #faf9f4;
                padding: 4px 7px;
                min-height: 33px;
                text-align: center;
            }
            .row3 .cap {
                display: block;
                margin: -4px -7px 3px;
                padding: 2px 5px;
                background: #f3e49c;
                font-size: 8px;
                font-weight: 800;
            }

            .main {
                display: grid;
                grid-template-columns: 43% 57%;

                margin-top: 0;
                position: relative;
                z-index: 1;
            }
            .left,
            .right {

            }
            .right .box, .right .box-title {
                  border-radius: 10px 10px 0 0;
            }
            
            .box-title {
                background: #f0df8a;
                text-align: center;
                font-weight: 800;
                font-size: 9px;
                padding: 3px 5px;
                border-bottom: 1px solid #222;
            }
            .floutter {
                filter: blur(8px);
            }
            .box-title.orange {
                background: #ee7b17;
            }
            .content {
                padding: 5px 7px;
                font-size: 9.5px;
                line-height: 1.35;
            }
            .center {
                text-align: center;
            }
            .big {
                font-size: 12px;
                font-weight: 700;
            }
            .minor {
                min-height: 160px;
            }
            .minor strong {
                display: block;
                margin-bottom: 5px;
            }
            .field-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 4px 6px;
            }
            .f {
                border: 1px solid #b6b6b6;
                border-radius: 6px;
                min-height: 29px;
                padding: 4px 6px;
                background: rgba(255, 255, 255, 0.55);
            }
            .f label {
                display: block;
                font-size: 8px;
                font-weight: 600;
                color: #000;
                margin-bottom: 2px;
            }
            .masquer-info {
                filter: blur(6px);
                opacity: 0.75;
                user-select: none;
                pointer-events: none;
            }
            .vehicle {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 4px;
            }
            .span2 {
                grid-column: span 2;
            }
            .span3 {
                grid-column: span 3;
            }
            .km {
                font-size: 13px;
                font-weight: 700;
                text-align: center;
                padding: 14px 0;
            }
            .measures {

                bottom: 0;
                min-height: 250px;
            }
            .measures table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.5px;
            }
            .measures th,
            .measures td {
                padding: 2px 3px;
                text-align: center;
            }
            .measures td:first-child,
            .measures th:first-child {
                text-align: left;
            }
            .footer-space {
                min-height: 115px;
                border: 1px solid #222;
                border-top: 0;
                position: relative;
                z-index: 1;
            }
            .stamp {
                position: absolute;
                left: 51mm;
                bottom: 22mm;
                width: 30mm;
                height: 26mm;
                border: 3px solid #888;
                border-radius: 5px;
                background: linear-gradient(135deg, #d9c74d, #efe190);
                opacity: 0.55;
                box-shadow: 0 0 0 5px rgba(90, 90, 90, 0.13);
            }
            .fold {
                position: absolute;
                left: 0;
                right: 0;
                top: 51%;
                height: 8px;
                background: linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 0.07),
                    rgba(255, 255, 255, 0.5),
                    rgba(0, 0, 0, 0.035)
                );
                opacity: 0.65;
                pointer-events: none;
                z-index: 2;
            }
            @media print {
                body {
                    background: #fff;
                }
                .paper {
                    margin: 0;
                    box-shadow: none;
                }
            }

            /* ===== Disposition fidèle à la capture ===== */
            .left .box {
                margin: 0;
                border-left: 0;
                border-right: 0;
                border-radius: 10px 10px 0 0;
            }
            .left .box-title {
                height: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1px 4px;
                font-size: 8px;
                line-height: 1;
                border: 1px solid #222;
                border-radius: 10px 10px 0 0;
                background: #f0df8a;
            }
            .left .box-title.orange {
                background: #ee7b17;
            }
            .left .box > .content,
            .left .box > .km {
                margin-top: -1px;
                border-left: 1px solid #222;
                border-right: 1px solid #222;
                border-bottom: 1px solid #222;
                border-radius: 0 0 10px 10px;
                background: rgba(250, 249, 244, 0.78);
            }
            .left .center.big {
                min-height: 34px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                padding: 6px;
            }
            .left .nature-next {
                min-height: 58px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                font-weight: 700;
                font-size: 10px;
            }
            .centre-content {
                min-height: 112px;
                padding: 7px 8px 5px !important;
                line-height: 1.45;
            }
            .centre-row {
                display: grid;
                grid-template-columns: 95px 1fr;
                align-items: baseline;
                margin-bottom: 3px;
            }
            .centre-row .lbl,
            .controller-row .lbl {
                font-size: 7.5px;
                font-weight: 700;
            }
            .centre-row b,
            .controller-row b {
                font-size: 8.5px;
            }
            .centre-address {
                text-align: center;
                font-weight: 700;
                margin-top: 8px;
                margin-bottom: 5px;
            }
            .centre-phone {
                text-align: center;
                font-size: 8.5px;
            }
            .controller-content {
                min-height: 78px;
                display: grid;
                grid-template-columns: 58% 42%;
                padding: 6px 8px !important;
            }
            .controller-info {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
            .controller-row {
                display: grid;
                grid-template-columns: 88px 1fr;
                align-items: baseline;
            }
            .controller-signature {
                min-height: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }
            .controller-signature .fake-signature {
                font-family: "Brush Script MT", "Segoe Script", cursive;
                font-size: 24px;
                transform: rotate(-5deg);
                white-space: nowrap;
            }
            .vehicle-content {
                padding: 5px !important;
            }
            .vehicle {
                grid-template-columns: 1fr 1fr 1fr;
                gap: 3px;
            }
            .vehicle .f {
                min-height: 36px;
                padding: 3px 4px;
                border-radius: 6px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                background: rgba(255, 255, 255, 0.28);
            }
            .vehicle .f label {
                font-size: 6.8px;
                line-height: 1.05;
                margin-bottom: 4px;
                text-align: center;
            }
            .vehicle .f b {
                font-size: 8.5px;
                line-height: 1.05;
            }
            .left .km {
                min-height: 47px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 8px 0;
                font-size: 11px;
            }
            .left .adverse-info {
                height: 44px;
                padding: 0 !important;
            }

            /* ===== Labels véhicule hors des cadres ===== */
            .vehicle {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 4px;
            }

            .vehicle-item {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .vehicle-item.span2 {
                grid-column: span 2;
            }

            .vehicle-item.span3 {
                grid-column: span 2;
            }

            .vehicle-item > label {
                display: block;
                min-height: 14px;
                margin: 0 0 2px;
                font-size: 6.5px;
                line-height: 1;
                font-weight: 800;
                color: #000;
                text-align: center;
            }

            .vehicle-item .f {
                min-height: 30px;
                padding: 3px 4px;
                border: 1px solid #b6b6b6;
                border-radius: 6px;
                background: rgba(255, 255, 255, 0.32);
                font-weight: 800;
                display: flex;
                align-items: center;
                justify-content: center;

                text-align: center;
                overflow: hidden;
            }

            .vehicle-item .f b,
            .vehicle-item .f .value {
                font-size: 8.5px;
                line-height: 1.05;
                font-weight: 800;
                word-break: break-word;
            }

            .vehicle-item .f.document {
                min-height: 36px;
                font-size: 8px;
                font-weight: 400;
            }

            /* Neutralise l'ancien label interne si une occurrence subsiste */
            .vehicle .f > label {
                display: none !important;
            }
        </style>
    </head>
    <body>
        <div class="paper">
            <div class="fold"></div>

            <div class="top">
                <div class="barcode-wrap">
                    <div class="barcode"></div>
                    N° d'imprimé : <span class="masquer-info">D&nbsp;&nbsp;103731421</span>
                </div>
                <div class="title">PROCÈS-VERBAL<br />DE CONTRÔLE TECHNIQUE</div>
                <div class="brand">
                    <span>
                        <img src="data:image/png;base64,
                        " alt="logo" style="width:100%;height:80px;overflow:hidden;">
                    </span>
                </div>
            </div>

            <div class="row3">
                <div><span class="cap">NATURE DU CONTRÔLE</span><b>Contrôle technique périodique</b></div>
                <div><span class="cap">(3) DATE DU CONTRÔLE</span><b>{{vehicle.controlDate}}</b></div>
                <div><span class="cap">N° DU PROCÈS-VERBAL</span><b class="masquer-info">20002614</b></div>
            </div>

            <div class="main">
                <div class="left">
                    <div class="box">
                        <div class="box-title orange">(7) RÉSULTAT DU CONTRÔLE</div>
                        <div class="content center big">Favorable</div>
                    </div>

                    <div class="box">
                        <div class="box-title">(8) LIMITE DE VALIDITÉ DU CONTRÔLE RÉALISÉ</div>
                        <div class="content center big">{{vehicle.limitValiditeControl}}</div>
                    </div>

                    <div class="box">
                        <div class="box-title">NATURE DU PROCHAIN CONTRÔLE</div>
                        <div class="content nature-next">Contrôle technique périodique</div>
                    </div>

                    <div class="box ">
                        <div class="box-title">IDENTIFICATION DU CENTRE DE CONTRÔLE</div>
                        <div class="content centre-content masquer-info">
                            <div class="centre-row"><span class="lbl">N° D'AGRÉMENT :</span><b>S084D144</b></div>
                            <div class="centre-row">
                                <span class="lbl">(9) RAISON SOCIALE :</span><b>SORGUES CONTROLE</b>
                            </div>
                            <div class="centre-row">
                                <span class="lbl">(3) COORDONNÉES :</span><b>1171, Route d'Entraigues</b>
                            </div>
                            <div class="centre-address">84700 SORGUES</div>
                            <div class="centre-phone">Tél : <b>04.90.16.04.73</b>&nbsp;&nbsp;&nbsp;&nbsp; Fax :</div>
                        </div>
                    </div>

                    <div class="box">
                        <div class="box-title">(9) IDENTIFICATION DU CONTRÔLEUR</div>
                        <div class="content controller-content masquer-info">
                            <div class="controller-info">
                                <div class="controller-row">
                                    <span class="lbl">NOM ET PRÉNOM :</span><b>MHIMDAT SOUFIAN</b>
                                </div>
                                <div class="controller-row">
                                    <span class="lbl">N° D'AGRÉMENT :</span><b>084D1125</b>
                                </div>
                                <div class="controller-row"><span class="lbl">SIGNATURE :</span><span></span></div>
                            </div>
                            <div class="controller-signature"><span class="fake-signature">S. Mhimdat</span></div>
                        </div>
                    </div>

                    <div class="box">
                        <div class="box-title">IDENTIFICATION DU VÉHICULE</div>
                        <div class="content vehicle-content">
                            <div class="vehicle">
                                <div class="vehicle-item">
                                    <label>(2) Immatriculation et pays</label>
                                    <div class="f"><b>{{vehicle.immatriculation}} (F)</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>Date d'immatriculation</label>
                                    <div class="f"><b>{{vehicle.firstImmatriculationDate}}</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>Date de 1ère mise en circulation</label>
                                    <div class="f"><b>{{vehicle.datePremiereMiseEnCirculation}}</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>Marque</label>
                                    <div class="f"><b>{{vehicle.version}}</b></div>
                                </div>

                                <div class="vehicle-item span2">
                                    <label>Désignation commerciale</label>
                                    <div class="f"><b>{{site_setting('company_name')}}</b></div>
                                </div>

                                <div class="vehicle-item span2 ">
                                    <label>(1) N° dans la série du type</label>
                                    <div class="f"><b class="masquer-info"> {{ mask_vin(vehicle.vim) }}</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>(5) Catégorie internationale</label>
                                    <div class="f"><b>{{vehicle.genreV}}</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>Genre</label>
                                    <div class="f"><b>{{vehicle.genreVGC}}</b></div>
                                </div>

                                <div class="vehicle-item span2">
                                    <label>Type/CNIT</label>
                                    <div class="f"><b>{{vehicle.cnit}}</b></div>
                                </div>

                                <div class="vehicle-item">
                                    <label>Énergie</label>
                                    <div class="f"><b>{{vehicle.classeEnvironnementale}}</b></div>
                                </div>

                                <div class="vehicle-item span2">
                                    <label>Document(s) présenté(s)</label>
                                    <div class="f document">Certificat d'immatriculation</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="box">
                        <div class="box-title">(4) KILOMÉTRAGE RELEVÉ</div>
                        <div class="km">{{vehicle.kilometrageReleve}}</div>
                    </div>

                    <div class="box">
                        <div class="box-title">INFORMATIONS SUR LE CONTRÔLE TECHNIQUE DÉFAVORABLE</div>
                        <div class="content adverse-info"></div>
                    </div>
                </div>

                <div class="right" style="position: relative !important">
                    <div class="box minor"style="border-radius:  10px 10px 10px 10px;height:85%;border:1px solid black;  ">
                        <div class="box-title orange">(6) DÉFAILLANCES ET NIVEAUX DE GRAVITÉ</div>
                        <div class="content">
                            <strong>DÉFAILLANCE(S) MINEURE(S):</strong>
                            <b>3.5.1.a.1. LAVE-GLACE DU PARE-BRISE :</b> Mauvais fonctionnement<br />
                            <b>8.2.2.2.d.1. OPACITÉ :</b> Connexion impossible sans dysfonctionnement du témoin OBD
                        </div>
                    </div>

                    <div class="box measures" style="width: 100%; border-radius:  0 0 10px 10px;border:1px solid black;  ">
                        <div class="box-title orange">MESURES RÉALISÉES ET VALEURS LIMITES CORRESPONDANTES</div>
                        <div class="content">
                        <table>
    <tr>
        <th></th>
        <th colspan="2">AVANT</th>
        <th colspan="2">ARRIÈRE</th>
    </tr>
    <tr>
        <th></th>
        <th>G</th>
        <th>D</th>
        <th>G</th>
        <th>D</th>
    </tr>

    <tr>
        <td>Ripage (-8 à +8 m/km)</td>
        <td>-0,8 m/km</td>
        <td></td>
        <td></td>
        <td></td>
    </tr>

    <tr>
        <td>Dissymétrie suspension (≤30%)</td>
        <td>6 %</td>
        <td></td>
        <td>5 %</td>
        <td></td>
    </tr>

    <tr>
        <td>Forces verticales</td>
        <td>715 daN</td>
        <td></td>
        <td>510 daN</td>
        <td></td>
    </tr>

    <tr>
        <td>Forces de freinage</td>
        <td>286 daN</td>
        <td>278 daN</td>
        <td>194 daN</td>
        <td>188 daN</td>
    </tr>

    <tr>
        <td>Déséquilibre (&lt;20%)</td>
        <td></td>
        <td>3 %</td>
        <td></td>
        <td>3 %</td>
    </tr>

    <tr>
        <td>Taux d'efficacité globale (≥50%)</td>
        <td colspan="4">76 %</td>
    </tr>

    <tr>
        <td>Feux de croisement</td>
        <td>-1,0 %</td>
        <td>-1,1 %</td>
        <td></td>
        <td></td>
    </tr>

    <tr>
        <td>Feux de brouillard avant</td>
        <td>-1,5 %</td>
        <td>-1,6 %</td>
        <td></td>
        <td></td>
    </tr>
</table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-space"></div>
            <div class="stamp"></div>
        </div>
    </body>
</html>
