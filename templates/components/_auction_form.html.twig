<aside class="card-luxe order-1 p-6 h-fit">
    <!-- Header -->
    <div class="mb-5 flex items-start justify-between gap-4">
        <div>
            <h2 class="text-[28px] font-semibold leading-tight text-gray-700">Achète / Offre</h2>
        </div>

        <div class="text-right">
            <div class="flex items-center justify-end gap-1 text-[20px] font-bold text-gray-800">
                <span id="js-countdown">01h 10m 25s</span>
                <span class="text-red-500">⏱</span>
            </div>
            <p class="mt-1 text-sm text-gray-400">20 août 2026, 13:40</p>
        </div>
    </div>
    <!-- TVA -->
    <div class="mb-6 flex items-center gap-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 text-xs font-bold text-gray-600">
            BBN
        </span>
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500 text-[11px] font-bold text-white">
            VAT
        </span>

        <span class="font-semibold text-gray-700"> TVA exclue </span>
    </div>

    <!-- Pricing -->
    <div class="mb-3 overflow-hidden rounded-md border border-gray-200 bg-white">
        <div class="flex items-center justify-between border-b border-gray-200 px-3 py-2">
            <span class="text-base text-gray-400"> Offre minimale: </span>
            <span class="text-lg font-semibold text-gray-500 underline decoration-dotted underline-offset-4">
                22100 €
            </span>
        </div>
        <div class="flex items-center justify-between px-3 py-2">
            <span class="text-base text-gray-400"> Prix de l'estimation: </span>
            <span class="text-lg font-semibold text-gray-500 underline decoration-dotted underline-offset-4">
                24100 €
            </span>
        </div>
    </div>

    <!-- Buy button -->
    <button
        type="button"
        class="mb-3 w-full rounded-md bg-green-600 px-4 py-3 text-lg font-medium text-white transition hover:bg-green-700"
    >
        ACHETER <span class="text-xl font-bold">22100€</span>
    </button>

    <!-- Offer controls -->
    <div class="mb-2 flex overflow-hidden rounded-md border border-gray-200">
        <button
            type="button"
            id="js-decr"
            class="flex h-10 w-10 items-center justify-center bg-gray-50 text-2xl font-bold text-gray-700 hover:bg-gray-100"
        >
            −
        </button>

        <input
            type="number"
            id="js-offer-input"
            value="24100"
            class="h-10 flex-1 border-x border-gray-200 bg-white text-center text-lg text-gray-900 outline-none"
        />

        <button
            type="button"
            id="js-incr"
            class="flex h-10 w-10 items-center justify-center bg-gray-50 text-2xl font-bold text-gray-700 hover:bg-gray-100"
        >
            +
        </button>
    </div>

    <button
        type="button"
        class="mb-3 w-full rounded-lg bg-black px-4 py-2.5 text-base font-medium uppercase text-white transition hover:bg-gray-600"
    >
        Faire une offre
    </button>

    <!-- Probability bar -->
    <div class="relative mb-10">
        <div class="flex h-2 overflow-hidden rounded-full">
            <div class="w-[20%] bg-red-500"></div>
            <div class="w-[20%] bg-orange-300"></div>
            <div class="w-[20%] bg-gray-200"></div>
            <div class="w-[40%] bg-green-500"></div>
        </div>

        <div class="absolute left-[68%] top-4 -translate-x-1/2">
            <div class="absolute -top-[6px] left-1/2 h-3 w-3 -translate-x-1/2 rotate-45 bg-green-500"></div>

            <span class="relative rounded-md bg-green-500 px-3 py-1 text-sm text-white"> probable </span>
        </div>
    </div>
    <!-- Total -->
    <div class="mb-7 flex items-center justify-between rounded-md bg-gray-100 px-4 py-2">
        <div class="flex items-center gap-2">
            <span class="text-lg font-bold text-gray-600"> Prix total </span>

            <button type="button" class="flex items-center gap-1 text-sm text-gray-600">
                Détails
                <span>↓</span>
            </button>
        </div>
        <span class="text-lg font-bold text-gray-600"> € 22500,00 </span>
    </div>
</aside>
