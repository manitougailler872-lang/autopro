{% set _base = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium' %}
{% set _class = 'bg-luxe-black-alt text-luxe-muted border border-luxe-border' %}
{% if status.badgeClass|default('') == 'badge-pending' %}{% set _class = 'bg-luxe-gold/15 text-luxe-gold border border-luxe-gold/30' %}{% endif %}
{% if status.badgeClass|default('') == 'badge-success' %}{% set _class = 'bg-green-500/15 text-green-400 border border-green-500/30' %}{% endif %}
{% if status.badgeClass|default('') == 'badge-danger' %}{% set _class = 'bg-red-500/15 text-red-400 border border-red-500/30' %}{% endif %}
{% if status.badgeClass|default('') == 'badge-neutral' %}{% set _class = 'bg-slate-500/15 text-slate-300 border border-slate-500/30' %}{% endif %}
<span class="{{ _base }} {{ _class }}">{{ status.label }}</span>
