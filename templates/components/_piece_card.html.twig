{% set img = vehicle.primaryImage %}
{% set _cta = cta|default('Voir détails') %}
<a href="{{ path('vehicle_detail', {slug: vehicle.slug}) }}" class="group relative flex flex-col card-luxe overflow-hidden hover:border-luxe-orange hover:shadow-lg hover:shadow-luxe-orange/5 transition-all duration-200 reveal">

    {% if vehicle.bestDeal is not null and vehicle.bestDealPercent > 0 and vehicle.isAvailable %}
        <div class="absolute -right-10 top-4 rotate-45 bg-green-600 text-white font-bold text-sm px-10 py-1 shadow-lg">
            -{{ vehicle.bestDealPercent }}%
        </div>
    {% endif %}

    {% if not vehicle.isAvailable %}
        <div class="absolute  left-5 top-5 rounded-r-full border border-luxe-orange bg-luxe-border px-5 py-2 text-sm font-semibold text-luxe-orange shadow-lg">
            Non disponible
        </div>
    {% endif %}

    <div class="aspect-[3/2] bg-luxe-black-alt overflow-hidden">
        {% if img %}
            <img src="{{ img.publicPath }}" alt="{{ vehicle.fullName }}" loading="lazy"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        {% else %}
            <div class="w-full h-full flex items-center justify-center text-4xl text-luxe-muted">🚗</div>
        {% endif %}
    </div>

    <div class="p-4 flex-1 flex flex-col">
        <div class="flex items-start justify-between gap-2 mb-1">
            <h3 class="font-display font-semibold ">{{ vehicle.brand }} {{ vehicle.model }}</h3>
            {% if vehicle.rating %}
                {% include 'components/_stars.html.twig' with {rating: vehicle.rating} %}
            {% endif %}
        </div>
        <p class="text-xs text-luxe-muted mb-3 truncate">{{ vehicle.version }}</p>

        <div class="flex  flex-wrap gap-1.5 text-xs text-luxe-muted mb-1">
            {% if vehicle.year is not empty %}
                <span class="chip">{{ vehicle.year }}</span>
            {% endif %}
            {% if vehicle.mileage is not empty %}
                <span class="chip">{{ vehicle.mileage|mileage }}</span>
            {% endif %}
            {% if vehicle.fuel is not empty %}
                <span class="chip">{{ vehicle.fuel.label }}</span>
            {% endif %}
        </div>
         <div class="flex mb-4 items-start gap-1.5 text-sm text-luxe-muted">
            <i data-lucide="calendar-check" class="w-4 h-4 text-emerald-400 mt-0.5"></i>
            <span class="text-emerald-400">
                Livraison gratuite sous 1 ou 2 jours<br>
            </span>
        </div>

        <div class="flex items-center justify-between mt-auto">
            <div class="text-luxe-orange text-xl font-bold">{{ vehicle.price|money_eur }}</div>
            {% if vehicle.isAvailable %}
                <span class="btn-gold text-xs py-1.5 px-4">{{ _cta }}</span>
            {% endif %}
        </div>
    </div>
</a>
