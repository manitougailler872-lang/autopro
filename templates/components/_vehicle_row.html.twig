{% set img = vehicle.primaryImage %}
<a href="{{ path('vehicle_detail', {slug: vehicle.slug}) }}"
   class="group flex flex-col sm:flex-row gap-4 bg-luxe-card border border-luxe-border rounded-xl p-4 hover:border-luxe-gold hover:shadow-lg hover:shadow-luxe-gold/5 transition-all duration-200 reveal">

    {# Thumbnail #}
    <div class="w-full sm:w-52 h-40 sm:h-32 rounded-lg overflow-hidden bg-luxe-black-alt shrink-0">
        {% if img %}
            <img src="{{ img.publicPath }}" alt="{{ vehicle.fullName }}" loading="lazy"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        {% else %}
            <div class="w-full h-full flex items-center justify-center text-4xl text-luxe-muted">🚗</div>
        {% endif %}
    </div>

    {# Info #}
    <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-lg mb-1">{{ vehicle.brand }} {{ vehicle.model }}</h3>
        <p class="text-xs text-luxe-muted mb-3">{{ vehicle.version }}</p>

        <div class="flex flex-wrap gap-2 text-xs text-luxe-muted">
            <span class="inline-flex items-center gap-1.5 bg-luxe-black-alt border border-luxe-border rounded-full px-2.5 py-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
                {{ vehicle.year }}
            </span>
            <span class="inline-flex items-center gap-1.5 bg-luxe-black-alt border border-luxe-border rounded-full px-2.5 py-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                {{ vehicle.mileage|mileage }}
            </span>
            <span class="inline-flex items-center gap-1.5 bg-luxe-black-alt border border-luxe-border rounded-full px-2.5 py-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 3h9v18H6zM15 8h3l2 2v9a2 2 0 01-2 2h-3"/></svg>
                {{ vehicle.fuel.label }}
            </span>
            <span class="inline-flex items-center gap-1.5 bg-luxe-black-alt border border-luxe-border rounded-full px-2.5 py-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 3v18M3 12h18"/></svg>
                Automatique
            </span>
        </div>
    </div>

    {# Price + CTA #}
    <div class="flex sm:flex-col items-end sm:items-end justify-between sm:justify-center gap-3 sm:min-w-[130px]">
        <div class="text-luxe-gold text-xl font-bold">{{ vehicle.price|money_eur }}</div>
        <span class="btn-gold text-xs py-1.5 px-4">Voir détails</span>
    </div>
</a>
