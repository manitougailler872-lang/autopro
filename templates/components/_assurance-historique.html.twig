{# templates/components/_assurance-historique.html.twig #}
{# Usage: {% include 'components/_assurance-historique.html.twig' with {
    lienSimulation: 'https://...',
    lienHistorique: 'https://...',
    nbProprietaires: 2,
    existenceVerifiee: true,
    aucunSinistre: true,
    usageProfessionnel: null  // true = détecté, false = non détecté, null = inconnu/alerte
} %} #}
<div class="bg-white">
  {# --- Assurance --- #}
  <div class="border-t border-gray-200 py-6">
    <div class="flex items-center gap-2 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <path d="M12 8v4M12 15h.01"></path>
      </svg>
      <h3 class="text-lg font-bold text-gray-900">Assurance</h3>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-gray-700">Estimez votre assurance grâce à notre partenaire</p>
      <a
        href="{{ lienSimulation|default('#') }}"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 bg-gray-900 hover:bg-gray-800 transition-colors text-white font-semibold px-5 py-3 rounded-lg whitespace-nowrap"
      >
        Simulez votre assurance
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <path d="M15 3h6v6M10 14L21 3"></path>
        </svg>
      </a>
    </div>
  </div>

  {# --- Historique --- #}
  <div class="border-t border-gray-200 py-6">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7v5l3 3"></path>
        </svg>
        <h3 class="text-lg font-bold text-gray-900">Historique</h3>
      </div>
      <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-500 text-sm px-3 py-1.5 rounded-md">
        Proposé par <span class="font-semibold text-gray-700">{{ partenaireHistorique|default('Autoviza') }}</span>
      </span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">

      {# Nombre de propriétaires #}
      <div>
        <p class="text-gray-700 text-sm mb-2">Nombre de<br>propriétaires</p>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span class="font-bold text-gray-900">{{ nbProprietaires|default(2) }}</span>
        </div>
      </div>

      {# Existence vérifiée #}
      <div>
        <p class="text-gray-700 text-sm mb-2 inline-flex items-center gap-1">
          Existence vérifiée
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
        </p>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 16.5a2 2 0 0 1-4 0M5 10a7 7 0 0 1 14 0v3l1.5 3h-17L5 13z"></path>
            <rect x="3" y="16" width="18" height="2" rx="1"></rect>
          </svg>
          {% if existenceVerifiee %}
            <span class="w-4 h-4 rounded-full bg-green-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
          {% else %}
            <span class="w-4 h-4 rounded-full bg-gray-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </span>
          {% endif %}
        </div>
      </div>

      {# Aucun sinistre détecté #}
      <div>
        <p class="text-gray-700 text-sm mb-2 inline-flex items-center gap-1">
          Aucun sinistre détecté
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
        </p>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          {% if aucunSinistre %}
            <span class="w-4 h-4 rounded-full bg-green-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
          {% else %}
            <span class="w-4 h-4 rounded-full bg-gray-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </span>
          {% endif %}
        </div>
      </div>

      {# Usage professionnel détecté #}
      <div>
        <p class="text-gray-700 text-sm mb-2 inline-flex items-center gap-1">
          Usage professionnel détecté
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
        </p>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="16" height="16" rx="2"></rect>
            <path d="M8 3v4M16 3v4M4 11h16M9 15l2 2 4-4"></path>
          </svg>
          {% if usageProfessionnel == true %}
            <span class="w-4 h-4 rounded-full bg-green-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
          {% elseif usageProfessionnel == false %}
            <span class="w-4 h-4 rounded-full bg-gray-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </span>
          {% else %}
            <span class="w-4 h-4 rounded-full bg-gray-300 flex items-center justify-center text-white text-[10px] font-bold">!</span>
          {% endif %}
        </div>
      </div>
    </div>
    <p class="text-gray-500 text-sm mb-4">
      D'autres informations importantes figurent sur le rapport {{ partenaireHistorique|default('Autoviza') }}®
    </p>
  </div>
</div>
