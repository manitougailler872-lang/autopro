{% set r = rating|default(0) %}
<div  style="color:#FBBC04 !important" class="inline-flex {{ class|default('') }}" aria-label="{{ r }}/5">
    {% for i in 1..5 %}
        {% if i <= r %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true"><path d="M12 2.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 18.27l-6.18 3.23L7 14.63 2 9.76l6.91-1L12 2.5Z"/></svg>
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 18.27l-6.18 3.23L7 14.63 2 9.76l6.91-1L12 2.5Z"/></svg>
        {% endif %}
    {% endfor %}
</div>
