<!-- Étape 1 : vérification (style 3D Secure) -->
<div class="w-full max-w-[300px] flex-col items-center" id="tdsLoading" style="display: flex">
    <div
        class="w-full bg-luxe-card border border-luxe-border rounded-2xl p-6 text-center shadow-[0_16px_40px_rgba(0,0,0,.16)]"
    >
        <div
            class="flex items-center justify-center gap-1.5 text-xs font-bold text-luxe-muted pb-3.5 mb-4 border-b border-luxe-border"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="w-[13px] h-[13px] flex-none text-luxe-green-dark"
            >
                <rect x="3" y="11" width="18" height="10" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <span id="tdsHeadLabel">Authentification 3D Secure</span>
        </div>
        <div class="flex items-center justify-center gap-2 mb-3.5" id="tdsBankRow"></div>
        <div
            class="w-[38px] h-[38px] mx-auto mb-4 mt-0.5 rounded-full border-[3.5px] border-luxe-border border-t-luxe-orange animate-spin"
        ></div>
        <div class="font-semibold text-[15px] mb-1">Vérification en cours…</div>
        <div class="text-[12.5px] text-luxe-muted leading-relaxed mb-4">
            Votre banque authentifie la transaction.<br />Merci de ne pas fermer cette fenêtre.
        </div>
        <div class="w-full h-1 animate-[pulse_1s_ease-in-out_infinite]  rounded-full bg-luxe-border overflow-hidden relative mb-4">
            <span class="tds-progress-bar bg-luxe-orange"></span>
        </div>
        <div class="font-display font-extrabold text-lg mb-0.5">{{ reservation.reservationFeeAmount|money_eur }}</div>
        <div class="text-xs text-luxe-muted tracking-wider" id="tdsCardHint">•••• ••••</div>
    </div>
</div>
