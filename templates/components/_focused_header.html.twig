{# Minimal centered header used by focused/modal-style pages
   Usage: {% include 'components/_focused_header.html.twig' with {title: 'Votre demande', back_url: path('...')} %}
#}
{% set _title    = title|default('Votre demande') %}
{% set _back_url = back_url|default(path('home')) %}

<header class="bg-luxe-black-alt border-b border-luxe-border">
    <div class="max-w-4xl mx-auto h-16 px-4 flex items-center relative">
        <a href="{{ path('reservation_payment', {uuid: reservation.uuid}) }}" aria-label="Retour" class="w-10 h-10 rounded-full flex items-center justify-center text-luxe-muted hover:text-luxe-text transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
        </a>
        <h1 class="absolute left-1/2 -translate-x-1/2 font-display font-semibold text-luxe-text">{{ _title }}</h1>
    </div>
</header>
