<footer id="contact" class="bg-black text-white border-t border-luxe-border mt-16">
    <div class="max-w-7xl mx-auto px-6 pt-14 pb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10 mb-10">
            {# Brand #}
            <div class="lg:col-span-1">
                {% set logo =  site_setting('company_logo') %}
                {% if logo is empty %}
                    {% set logo = 'default_company_logo.png' %}
                {% endif %}
                <div class="flex items-center gap-2 font-semibold text-lg mb-4">
                    <a href="{{ path('home') }}" class="inline-block">
                        <img
                            src="{{ asset('uploads/logos/logo-white.png') }}"
                            alt="AUTOPRO"
                            class="h-full w-full object-contain"
                        >
                    </a>
                </div>
                <p class="text-sm text-white leading-relaxed">Votre partenaire automobile de confiance. Qualité, transparence et satisfaction garanties.</p>
            </div>


            {# Nous contacter #}
            <div>
                <h6 class="text-white text-sm font-semibold mb-4">Nous contacter</h6>
                <ul class="space-y-3 text-sm text-white">
                    <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-luxe-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.13.93.37 1.85.72 2.72a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.36-1.29a2 2 0 012.11-.45c.87.35 1.79.59 2.72.72A2 2 0 0122 16.92z"/></svg>
                        {{ site_setting('company_phone') }}
                    </li>
                    <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-luxe-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M4 4l8 7 8-7"/></svg>
                        {{ site_setting('company_email') }}
                    </li>
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-luxe-gold mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s7-8 7-13a7 7 0 10-14 0c0 5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
                        {{ site_setting('company_address') }}
                    </li>
                    <li class="flex items-start gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-luxe-gold mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <circle cx="12" cy="12" r="9"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M12 7v5l3 2"/>
                        </svg>
                        {{ site_setting('open_hour') }}
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>
