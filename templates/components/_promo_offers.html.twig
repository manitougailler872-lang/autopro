{# templates/components/_promo_offers.html.twig
   Usage : {% include 'components/_promo_offers.html.twig' with {vehicles: featured_good_deals} %}
   Affiche 1 grande carte "Choix du jour" + 8 cartes (9 véhicules max). #}

{# ===== A ADAPTER : correspondance avec ton entité Vehicle (un seul endroit) ===== #}
{% set imageBase = 'uploads/vehicles/' %}
{% set items = [] %}
{% for v in vehicles|slice(0, 9) %}
    {% set items = items|merge([{
        title:   v.brand|default(v.brand|default('Véhicule')),
        price:   v.price|default(null),
        year:    v.year|default(null),
        image:   v.getPrimaryImage().filename|default(null),
        gallery: v.images|default([]),
        url:     path('vehicle_detail',{'slug': v.slug}),
        mileage: v.mileage|default(null),
        bestDeal: v.bestDeal|default(null),
        isAuction: v.isAuction|default(null),
    }]) %}
{% endfor %}

{% if items|length > 0 %}
<section class="max-w-7xl mx-auto px-6 py-10">

    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="text-2xl md:text-3xl font-display font-bold">Offres promotionnelles</h2>
            <p class="text-sm text-luxe-muted mt-1">Une sélection de véhicules à prix réduit</p>
        </div>
        <a href="{{ path('vehicle_list') }}" class="text-luxe-orange text-sm hover:underline font-medium">Tout voir →</a>
    </div>

    {# Grille principale : mobile = 1 colonne (grande carte puis petites cartes),
       lg = 2 colonnes égales, xl = 1/3 grande carte + 2/3 petites cartes #}
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">

        {# ===== Colonne 1 : carte vedette : Choix du jour ===== #}
        {% set f = items|first %}
        <article class="group relative rounded-xl">
            <a href="{{ f.url }}" class="block  focus-visible:outline-none" aria-label="{{ f.title }}">
                <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-luxe-border bg-luxe-black-alt">
                    {% if f.image %}
                        <img src="{{ asset(imageBase ~ f.image) }}" alt="{{ f.title }}" loading="lazy"
                             class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105">
                    {% endif %}
                    <span class="absolute text-black left-4 top-4 rounded-full bg-white px-3 py-1.5 text-sm font-medium text-luxe-text shadow-sm">Choix du jour</span>
                </div>
            </a>

            {% if f.gallery|length > 0 %}
                <div class="mt-2 grid grid-cols-3 gap-2">
                    {% for g in f.gallery|slice(0, 3) %}
                        <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-luxe-border bg-luxe-black-alt">
                            <img src="{{ asset(imageBase ~ g.filename) }}" alt="{{ f.title }} - photo {{ loop.index }}" loading="lazy" class="absolute inset-0 h-full w-full object-cover">
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <a href="{{ f.url }}" class="mt-4 block focus-visible:outline-none">
                <h3 class="truncate text-xl font-semibold text-luxe-text group-hover:text-luxe-orange-dark">{{ f.title }}</h3>
                <p class="mt-1 text-[15px] text-luxe-muted">
                    {% if f.price %}<span class="font-semibold">{{ f.price|number_format(0, ',', ' ') }} €</span>{% endif %}
                    {% if f.year %} &middot; {{ f.year }}{% endif %}
                     {% if f.mileage %} &middot; {{ f.mileage }}{% endif %}
                </p>
            </a>
        </article>

        {# ===== Colonne 2 : grille des petites cartes =====
        mobile/lg : 2 colonnes (6 cartes visibles en lg), xl : 4 colonnes (8 cartes) #}
       <div class="grid grid-cols-2 content-start gap-2  xl:grid-cols-4">
                {% for it in items|slice(1) %}
                    <article class="group relative{% if loop.index > 6 %} max-xl:lg:hidden{% endif %}">
                        <a href="{{ it.url }}" class="block relative focus-visible:outline-none" aria-label="{{ it.title }}">
                            <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-luxe-border bg-luxe-black-alt">
                                {% if it.image %}
                                    <img src="{{ asset(imageBase ~ it.image) }}" alt="{{ it.title }}" loading="lazy"
                                        class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105">
                                {% endif %}
                                {% if it.bestDeal or it.isAuction %}
                                    <div style="background-color:#F97316; color:white;" class="absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-medium uppercase">
                                        Bon plan
                                    </div>
                                {% else  %}
                                    <div style="background-color:#FACC15; color:black;" class="absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-medium uppercase">
                                        Occasion
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        <a href="{{ it.url }}" class="mt-3 block focus-visible:outline-none">
                            <h3 class="line-clamp-2 text-[15px] font-medium leading-snug text-luxe-text group-hover:text-luxe-orange-dark">{{ it.title }}</h3>
                            <p class="mt-1 text-[15px] text-luxe-muted">
                                {% if it.price %}<span class="font-semibold">{{ it.price|number_format(0, ',', ' ') }} €</span>{% endif %}
                                {% if it.year %} &middot; {{ it.year }}{% endif %}
                                {% if it.mileage %} &middot; {{ it.mileage }} km{% endif %}
                            </p>
                        </a>
                    </article>
                {% endfor %}
        </div>
    </div>
</section>

<script>
    // Bouton favori : bascule visuelle (coeur plein rouge). A relier à ton backend si besoin.
    document.querySelectorAll('.fav').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var on = btn.getAttribute('aria-pressed') !== 'true';
            btn.setAttribute('aria-pressed', on);
            btn.classList.toggle('bg-luxe-orange', on);
            btn.classList.toggle('bg-black/45', !on);
            btn.querySelector('svg').setAttribute('fill', on ? 'currentColor' : 'none');
        });
    });
</script>
{% endif %}
