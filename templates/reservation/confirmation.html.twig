{% extends 'base.html.twig' %}
{% block title %}Réservation confirmée — {{ reservation.reservationNumber }}{% endblock %}
{% block body %}
<div class="relative overflow-hidden">
    <div aria-hidden="true" class="confetti-container">
        {% for i in 1..24 %}
            <span class="confetti-dot" style="left: {{ (i * 4.1)|round }}%; animation-delay: {{ (loop.index0 * 0.15)|round(2) }}s; animation-duration: {{ (2.2 + (i % 5) * 0.3)|round(2) }}s;"></span>
        {% endfor %}
    </div>
    <div class="max-w-xl mx-auto px-6 py-16 text-center relative z-10">
        <div class="w-24 h-24 mx-auto mb-6 rounded-full border-2 border-luxe-orange flex items-center justify-center fade-in bg-luxe-orange-soft">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-12 h-12 text-luxe-orange" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7 6.3a1 1 0 010 1.4l-10.5 10.5a1 1 0 01-1.4 0l-5.5-5.5a1 1 0 011.4-1.4l4.8 4.79 9.8-9.79a1 1 0 011.4 0Z"/></svg>
        </div>
        <h1 class="text-3xl font-display font-bold mb-3 fade-in-up">
            {% if reservation.status.value == 'CONFIRMED' %}Réservation confirmée !{% else %}Demande enregistrée !{% endif %}
        </h1>
        <p class="text-luxe-muted text-sm mb-10 fade-in-up">
            Merci <span class="text-luxe-orange font-medium">{{ reservation.customerName }}</span>, votre réservation a été enregistrée avec succès.
        </p>
        <div class="card-luxe p-6 text-left mb-8">
            <h2 class="font-display font-semibold mb-5">Détails de votre réservation</h2>
            <div class="flex gap-4 pb-5 border-b border-luxe-border mb-5">
                {% if reservation.vehicle.primaryImage %}
                    <img src="{{ reservation.vehicle.primaryImage.publicPath }}" alt="" class="w-20 h-16 object-cover rounded-xl">
                {% endif %}
                <div>
                    <div class="font-display font-semibold">{{ reservation.vehicle.brand }} {{ reservation.vehicle.model }}</div>
                    <div class="text-xs text-luxe-muted">{{ reservation.vehicle.version }}</div>
                </div>
            </div>
            <dl class="text-sm space-y-3">
                <div class="flex justify-between"><dt class="text-luxe-muted">N° de réservation</dt><dd class="font-mono">{{ reservation.reservationNumber }}</dd></div>
                <div class="flex justify-between"><dt class="text-luxe-muted">Date</dt><dd>{{ reservation.createdAt|date('d/m/Y à H:i') }}</dd></div>
                <div class="flex justify-between"><dt class="text-luxe-muted">Mode de réception</dt><dd>{{ reservation.receptionMode.label }}</dd></div>
                {% if reservation.vehicle.vehicleType == 'CAR' %}
                    <div class="flex justify-between"><dt class="text-luxe-muted">Montant payé</dt><dd class="text-luxe-orange font-display font-bold">{{ reservation.reservationFeeAmount|money_eur }}</dd></div>
                {% else %}
                    <div class="flex justify-between"><dt class="text-luxe-muted">Montant payé</dt><dd class="text-luxe-orange font-display font-bold">{{ reservation.vehicle.price|money_eur }}</dd></div>
                {% endif %}
              </dl>
        </div>
        <p class="text-xs text-luxe-muted mb-6">
            Un e-mail de confirmation vous a été envoyé.<br>
            Notre équipe vous contactera bientôt pour finaliser votre réservation.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
           <a href="{{ path('refund_request', {uuid: reservation.uuid}) }}" class="btn-outline">Demander un remboursement</a>
            <a href="{{ path('home') }}" class="btn-outline">Retour à l'accueil</a>
        </div>
    </div>
</div>
{% endblock %}
