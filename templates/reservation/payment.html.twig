{% extends 'base.html.twig' %}
{% block title %}Paiement — {{ reservation.reservationNumber }} — AutoPro{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-6 py-8">
        <nav class="text-xs text-luxe-muted mb-4">
            <a href="{{ path('home') }}" class="hover:text-luxe-orange transition">Accueil</a>
            <span class="mx-1">/</span>
            <a href="{{ path('vehicle_detail', {slug: reservation.vehicle.slug}) }}" class="hover:text-luxe-orange transition">Réservation</a>
            <span class="mx-1">/</span>
            <span>Paiement</span>
        </nav>

        <h1 class="text-2xl font-display font-bold mb-1">Paiement des frais de réservation</h1>
        {% if reservation.vehicle.vehicleType == 'CAR' %}
            <p class="text-sm text-luxe-muted mb-6">Frais de réservation 20%</p>
        {% endif %}

        {# Vehicle summary shown at every step #}
        <div class="mb-6 mt-5">
            {% include 'components/_reservation_summary.html.twig' %}
        </div>

        {# Progress steps #}
        <div class="flex text-center items-center gap-2 mb-8 max-w-xl mx-auto">
            {% for step in [{n:1, done:true},{n:2, active:true},{n:3, active:false}] %}
                <div class="flex items-center gap-2 flex-1">
                <span class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold shrink-0 {{ step.active|default(false) or step.done|default(false) ? 'bg-luxe-orange text-white' : 'border border-luxe-border text-luxe-faint' }}">
                    {% if step.done|default(false) %}✓{% else %}{{ step.n }}{% endif %}
                </span>
                    {% if not loop.last %}<div class="flex-1 h-px {{ step.done|default(false) ? 'bg-luxe-orange' : 'bg-luxe-border' }}"></div>{% endif %}
                </div>
            {% endfor %}
        </div>

        <div class="grid grid-cols-1 mx-auto max-w-xl">
            {# LEFT: RECAP #}
            <div class="card-luxe p-6">
                <h2 class="font-display font-semibold mb-5">Récapitulatif de votre réservation</h2>

                <div class="flex gap-4 pb-5 border-b border-luxe-border mb-5">
                    {% if reservation.vehicle.primaryImage %}
                        <img src="{{ reservation.vehicle.primaryImage.publicPath }}" alt="" class="w-24 h-20 object-cover rounded-xl">
                    {% else %}
                        <div class="w-24 h-20 rounded-xl bg-luxe-black-alt flex items-center justify-center text-2xl">🚗</div>
                    {% endif %}
                    <div>
                        <div class="font-display font-semibold">{{ reservation.vehicle.brand }} {{ reservation.vehicle.model }}</div>
                        <div class="text-xs text-luxe-muted">{{ reservation.vehicle.version }}</div>
                    </div>
                </div>

                <dl class="text-sm space-y-3">
                    <div class="flex justify-between gap-4"><dt class="text-luxe-muted shrink-0">Nom</dt><dd class="text-right">{{ reservation.customerName }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-luxe-muted shrink-0">Téléphone</dt><dd class="text-right">{{ reservation.customerPhone }}</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-luxe-muted shrink-0">E-mail</dt><dd class="text-right break-all">{{ reservation.customerEmail }}</dd></div>
                    {% if reservation.vehicle.vehicleType == 'CAR' %}
                        <div class="flex justify-between"><dt class="text-luxe-muted">Prix du véhicule</dt><dd>{{ reservation.vehiclePriceSnapshot|money_eur }}</dd></div>
                    {% else %}
                        <div class="flex justify-between"><dt class="text-luxe-muted">Prix de l'article</dt><dd>{{ reservation.reservationFeeAmount|money_eur }}</dd></div>
                    {% endif %}
                    {% if reservation.vehicle.vehicleType == 'CAR' %}
                        <div class="flex justify-between"><dt class="text-luxe-muted">Frais de réservation ({{ reservation.reservationFeePercentage|number_format(0) }}%)</dt><dd>{{ reservation.reservationFeeAmount|money_eur }}</dd></div>
                    {% endif %}
                    <div class="flex justify-between"><dt class="text-luxe-muted">Mode de réception</dt><dd>{{ reservation.receptionMode.label }}</dd></div>
                </dl>

                <div class="max-w-full mx-auto">
                    {# Bouton 1 : Paiement par carte #}
                   
                    <a href="{{ path('reservation_pay', {uuid: reservation.uuid}) }}">
                        <button type="button" class="w-full mt-2 bg-black hover:bg-luxe-orange-dark text-white font-semibold text-md rounded-full px-6 py-2 shadow-lg shadow-luxe-orange/20 hover:shadow-luxe-orange/30 active:scale-[0.99] transition-all duration-150 inline-flex items-center justify-center gap-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-luxe-orange">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M11.55 2.11a1 1 0 011.06.35l.06.09 8.5 5.44a1 1 0 01-.54 1.83H3.37a1 1 0 01-.54-1.83l8.5-5.44a1 1 0 01.22-.14ZM4 11h2v7h1v-7h3v7h1v-7h3v7h1v-7h3v7h1v-7h2a1 1 0 011 1v1H3v-1a1 1 0 011-1Zm-1 9h18a1 1 0 010 2H3a1 1 0 010-2Z"/>
                            </svg>
                            Procéder au paiement par carte bancaire
                        </button>
                    </a>

                    {# Divider "OU" #}
                    <div class="flex items-center gap-3 my-5">
                        <div class="flex-1 h-px bg-luxe-border"></div>
                        <span class="text-luxe-muted text-xs uppercase tracking-widest font-medium">OU</span>
                        <div class="flex-1 h-px bg-luxe-border"></div>
                    </div>
                    <a href="{{ path('reservation_payment_by_rib', {uuid: reservation.uuid}) }}">
                        <button type="button" class="w-full mt-5 mb-2 bg-black hover:bg-luxe-orange-dark text-white font-semibold text-md rounded-full xl px-6 py-2 shadow-lg shadow-luxe-orange/20 hover:shadow-luxe-orange/30 active:scale-[0.99] transition-all duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-luxe-orange">
                            Virement bancaire
                        </button>
                    </a>
                    <a href="{{ path('payment_by_leboncoin', {uuid: reservation.uuid}) }}">
                        <button type="button" class="w-full mt-2 bg-black hover:bg-luxe-orange-dark text-white font-semibold text-md rounded-full px-6 py-2 shadow-lg shadow-luxe-orange/20 hover:shadow-luxe-orange/30 active:scale-[0.99] transition-all duration-150 inline-flex items-center justify-center gap-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-luxe-orange">
                           <svg xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="M19 5.5A7 7 0 0 0 7.2 9H4"/>
                                <path d="M4 9h11"/>
                                <path d="M4 15h11"/>
                                <path d="M7.2 15A7 7 0 0 0 19 18.5"/>
                            </svg>
                            Paiement sécurisé Leboncoin
                        </button>
                    </a>
                    {# Bouton 2 : Virement bancaire #}

                </div>

                <div class="mt-8 pt-6 border-t border-luxe-border flex justify-between items-center">
                    <span class="text-luxe-text font-display font-semibold">Montant à payer</span>
                    <span class="text-luxe-text text-3xl font-display font-bold">{{ reservation.reservationFeeAmount|money_eur }}</span>
                </div>

                {% if reservation.vehicle.vehicleType == 'CAR' %}
                    <div class="bg-luxe-card border border-luxe-orange/40 rounded-2xl mt-5 p-6" style="margin-top:20px;">
                        <div class="flex items-center gap-2 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 text-luxe-orange shrink-0" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.29 3.86a2 2 0 0 1 3.42 0l8.15 13.98A2 2 0 0 1 20.15 21H3.85a2 2 0 0 1-1.71-3.16l8.15-13.98ZM12 8.75a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4a.75.75 0 0 1 .75-.75Zm0 9.25a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/>
                            </svg>
                            <h3 class="text-luxe-orange font-display font-semibold text-lg">Informations importantes</h3>
                        </div>
                        <p class="text-luxe-muted text-sm leading-relaxed">
                            {{ settings.payment_message }}
                        </p>
                    </div>
                {% else %}
                    <div class="bg-luxe-card border border-luxe-orange/40 rounded-2xl mt-5 p-6" style="margin-top:20px;">
                        <div class="flex items-center gap-2 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 text-luxe-orange shrink-0" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.29 3.86a2 2 0 0 1 3.42 0l8.15 13.98A2 2 0 0 1 20.15 21H3.85a2 2 0 0 1-1.71-3.16l8.15-13.98ZM12 8.75a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4a.75.75 0 0 1 .75-.75Zm0 9.25a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/>
                            </svg>
                            <h3 class="text-luxe-orange font-display font-semibold text-lg">Informations importantes</h3>
                        </div>
                        <p class="text-luxe-muted text-sm leading-relaxed">
                            {{ settings.payment_message_v1 }}
                        </p>
                    </div>
                {% endif %}

                <div class="flex flex-col sm:flex-row gap-3 justify-center my-3">
                    <a href="{{ path('reservation_release_funds', {uuid: reservation.uuid}) }}" class="btn-gold w-full">Faire une demande</a>
                </div>

            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('[data-clip]').forEach(b => {
            b.addEventListener('click', () => {
                navigator.clipboard.writeText(b.dataset.clip);
                const orig = b.textContent;
                b.textContent = '✓ Copié';
                setTimeout(() => b.textContent = orig, 1600);
            });
        });
    </script>
{% endblock %}
