{% extends 'base.html.twig' %}


{% block body %}

<div class="max-w-[620px] mx-auto px-[18px] pt-9 pb-16">
       <nav class="text-xs text-luxe-muted mb-4">
            <a href="{{ path('home') }}" class="hover:text-luxe-orange transition">Accueil</a>
            <span class="mx-1">/</span>
            <a href="{{ path('vehicle_detail', {slug: reservation.vehicle.slug}) }}" class="hover:text-luxe-orange transition">Réservation</a>
            <span class="mx-1">/</span>
            <span>Paiement</span>
        </nav>

        <h1 class="text-2xl font-display font-bold mb-1">Paiement par carte bancaire</h1>
        <p class="text-sm text-luxe-muted mb-6">Délai : instantané ou 2 à 3 jours ouvrés.</p>

        {# Vehicle summary shown at every step #}
        <div class="mb-6">
            {% include 'components/_reservation_summary_v2.html.twig' %}
        </div>

    <div class="flex items-center justify-center mb-[30px]">
        <div
            class="w-[30px] h-[30px] rounded-full flex items-center justify-center text-[13px] font-bold flex-none border-2 border-luxe-orange bg-luxe-orange text-white"
        >
            ✓
        </div>
        <div class="w-16 h-0.5 bg-luxe-orange"></div>
        <div
            class="w-[30px] h-[30px] rounded-full flex items-center justify-center text-[13px] font-bold flex-none border-2 border-luxe-orange text-luxe-orange bg-luxe-card"
        >
            2
        </div>
        <div class="w-16 h-0.5 bg-luxe-border"></div>
        <div
            class="w-[30px] h-[30px] rounded-full flex items-center justify-center text-[13px] font-bold flex-none border-2 border-luxe-border text-luxe-muted bg-luxe-card"
        >
            3
        </div>
    </div>

    <div class="relative">
        <form
            class="bg-luxe-card border border-luxe-border rounded-2xl p-[26px] animate-fade-in-up"
            id="payForm"
            novalidate
        >
            <input
                type="hidden"
                id="payment_url"
                value="{{path('paiement_verifier')}}"
            />
            <input
                type="hidden"
                id="redirectUrl"
                value="{{path('reservation_confirmation',{uuid:reservation.uuid})}}"
            />
            <input
                type="hidden"
                id="reservation_uuid"
                name="reservation_uuid"
                value="{{reservation.uuid}}"
            />
            <div class="flex items-center justify-between mb-5">
                <h2 class="font-display font-bold text-xl tracking-[-.2px]">Coordonnées bancaires</h2>
                <div
                    class="text-[11.5px] font-semibold text-luxe-green-dark flex items-center gap-1.5 bg-luxe-green-soft px-2.5 py-1.5 rounded-full"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        class="w-3 h-3 flex-none"
                    >
                        <rect x="3" y="11" width="18" height="10" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    SSL 256-bit
                </div>
            </div>

            <div class="mb-4">
                <label for="holder" class="block text-[12.5px] font-semibold text-luxe-muted mb-1.5"
                    >Titulaire de la carte</label
                >
                <input
                    type="text"
                    id="holder"
                    name="holder"
                    placeholder="Nom sur la carte"
                    autocomplete="cc-name"
                    required
                    class="w-full border-[1.5px] border-luxe-border rounded-xl px-3.5 py-3 text-[15px]  text-luxe-text bg-luxe-black-alt outline-none tracking-[.3px] transition-colors focus:border-luxe-orange focus:shadow-[0_0_0_3px_rgba(237,23,25,.12)] focus:bg-luxe-card"
                />
                <span class="block text-xs text-luxe-orange-dark mt-1.5 min-h-[14px]" id="err-holder"></span>
            </div>

            <div class="mb-4">
                <label for="number" class="block text-[12.5px] font-semibold text-luxe-muted mb-1.5"
                    >Numéro de carte</label
                >
                <div class="relative">
                    <input
                        type="text"
                        id="number"
                        name="number"
                        inputmode="numeric"
                        placeholder="0000 0000 0000 0000"
                        autocomplete="cc-number"
                        maxlength="23"
                        required
                        class="w-full border-[1.5px] border-luxe-border rounded-xl pl-3.5 pr-[52px] py-3 text-[15px] text-luxe-text bg-luxe-black-alt outline-none tracking-[1px] transition-colors [font-variant-numeric:tabular-nums] focus:border-luxe-orange focus:shadow-[0_0_0_3px_rgba(237,23,25,.12)] focus:bg-luxe-card"
                    />
                    <div
                        class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-6 flex items-center justify-center pointer-events-none"
                        id="brandChip"
                    >
                        <span class="flex items-center justify-center brand-chip-inner" id="brandChipInner"></span>
                    </div>
                </div>
                <span class="block text-xs text-luxe-orange-dark mt-1.5 min-h-[14px]" id="err-number"></span>
            </div>

            <div class="grid grid-cols-2 gap-3.5">
                <div class="mb-4">
                    <label for="expiry" class="block text-[12.5px] font-semibold text-luxe-muted mb-1.5"
                        >Date d'expiration</label
                    >
                    <input
                        type="text"
                        id="expiry"
                        name="expiry"
                        inputmode="numeric"
                        placeholder="MM / AA"
                        autocomplete="cc-exp"
                        maxlength="7"
                        required
                        class="w-full border-[1.5px] border-luxe-border rounded-xl px-3.5 py-3 text-[15px] text-luxe-text bg-luxe-black-alt outline-none tracking-[1px] transition-colors focus:border-luxe-orange focus:shadow-[0_0_0_3px_rgba(237,23,25,.12)] focus:bg-luxe-card"
                    />
                    <span class="block text-xs text-luxe-orange-dark mt-1.5 min-h-[14px]" id="err-expiry"></span>
                </div>
                <div class="mb-4">
                    <label for="cvv" class="block text-[12.5px] font-semibold text-luxe-muted mb-1.5"
                        >Cryptogramme (CVV)</label
                    >
                    <input
                        type="password"
                        id="cvv"
                        name="cvv"
                        inputmode="numeric"
                        placeholder="•••"
                        autocomplete="cc-csc"
                        maxlength="4"
                        required
                        class="w-full border-[1.5px] border-luxe-border rounded-xl px-3.5 py-3 text-[15px] text-luxe-text bg-luxe-black-alt outline-none tracking-[1px] transition-colors focus:border-luxe-orange focus:shadow-[0_0_0_3px_rgba(237,23,25,.12)] focus:bg-luxe-card"
                    />
                    <span class="block text-xs text-luxe-orange-dark mt-1.5 min-h-[14px]" id="err-cvv"></span>
                </div>
            </div>

            <div class="pt-[18px] border-t border-dashed border-luxe-border">
                <div class="text-xs text-luxe-muted mb-2.5 font-semibold">Moyens de paiement acceptés</div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <div
                        class="border border-luxe-border rounded-lg px-2.5 h-[30px] flex items-center justify-center bg-luxe-black-alt"
                        title="Visa"
                    >
                        <img
                            src="data:image/png;base64,"
                            alt="Visa"
                            style="height: 20px; display: block"
                        />
                    </div>
                    <div
                        class="border border-luxe-border rounded-lg px-2.5 h-[30px] flex items-center justify-center bg-luxe-black-alt"
                        title="Mastercard"
                    >
                        <svg width="28" height="17" viewBox="0 0 1000 618" xmlns="http://www.w3.org/2000/svg">
                            <path fill="#EB001B" d="m308,0a309,309 0 1,0 2,0z" />
                            <path fill="#F79E1B" d="m690,0a309,309 0 1,0 2,0z" />
                            <path fill="#FF5F00" d="m500,66a309,309 0 0,0 0,486 309,309 0 0,0 0-486" />
                        </svg>
                    </div>
                </div>
            </div>

            <button
                type="submit"
                id="payBtn"
                class="mt-[22px] w-full border-none rounded-xl bg-luxe-orange text-white font-bold text-base py-[15px] cursor-pointer flex items-center justify-center gap-[9px] transition-colors hover:bg-luxe-orange-dark active:scale-[.99] disabled:opacity-55 disabled:cursor-not-allowed"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-[17px] h-[17px] flex-none"
                >
                    <rect x="3" y="11" width="18" height="10" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Payer&nbsp;{{ reservation.reservationFeeAmount|money_eur }}
            </button>

            <p class="text-center text-xs text-luxe-muted mt-3.5 leading-relaxed">
                Vos coordonnées bancaires sont vérifiées puis <b class="text-luxe-text">immédiatement transmises</b> à
                notre prestataire de paiement. LuxeCar Express
                <b class="text-luxe-text">ne stocke aucune donnée de carte</b> sur ses serveurs.
            </p>
        </form>

        <div
            class="absolute inset-0 bg-white/30 backdrop-blur-[2px] rounded-2xl items-center justify-center z-50 p-[18px] hidden"
            id="overlay"
        >
          
        {% include 'components/payment/_pending.html.twig' %}
        {% include 'components/payment/_validate.html.twig' %}
        {% include 'components/payment/_canceled.html.twig' %}

        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
<script>
(function(){
  const form      = document.getElementById('payForm');
  const holderEl  = document.getElementById('holder');
  const numberEl  = document.getElementById('number');
  const expiryEl  = document.getElementById('expiry');
  const cvvEl     = document.getElementById('cvv');
  const brandChip = document.getElementById('brandChip');
  const brandChipInner = document.getElementById('brandChipInner');
  const overlay   = document.getElementById('overlay');
  const payBtn    = document.getElementById('payBtn');

  const tdsLoading = document.getElementById('tdsLoading');
  const tdsSuccess = document.getElementById('tdsSuccess');
  const tdsFail     = document.getElementById('tdsFail');
  const tdsHeadLabel= document.getElementById('tdsHeadLabel');
  const tdsBankRow  = document.getElementById('tdsBankRow');
  const tdsCardHint = document.getElementById('tdsCardHint');
  const tdsFailReason = document.getElementById('tdsFailReason');
  const tdsContinueBtn = document.getElementById('tdsContinueBtn');
  const tdsRetryBtn    = document.getElementById('tdsRetryBtn');
  const paymentUrl = document.getElementById('payment_url');
  const reservationUuid = document.getElementById('reservation_uuid');
  const redirectUrl = document.getElementById('redirectUrl');

  const errs = {
    holder: document.getElementById('err-holder'),
    number: document.getElementById('err-number'),
    expiry: document.getElementById('err-expiry'),
    cvv:    document.getElementById('err-cvv'),
  };
  const inputEls = {
    holder: holderEl, number: numberEl, expiry: expiryEl, cvv: cvvEl
  };

  const INVALID_CLASSES = ['border-luxe-orange-dark','bg-luxe-orange-soft'];

  const brandSvg = {
    visa: '<img src="data:image/png;base64," alt="Visa" style="height:16px;display:block;">',
    mastercard: '<svg width="24" height="15" viewBox="0 0 1000 618" xmlns="http://www.w3.org/2000/svg"><path fill="#EB001B" d="m308,0a309,309 0 1,0 2,0z"/><path fill="#F79E1B" d="m690,0a309,309 0 1,0 2,0z"/><path fill="#FF5F00" d="m500,66a309,309 0 0,0 0,486 309,309 0 0,0 0-486"/></svg>'
  };

  // ---------- formatting: card number, grouped by 4 ----------
  let currentBrand = null;

  numberEl.addEventListener('input', () => {
    let digits = numberEl.value.replace(/\D/g,'').slice(0,19);
    let grouped = digits.replace(/(.{4})/g,'$1 ').trim();
    numberEl.value = grouped;
    detectBrand(digits);
    clearError('number');
  });

  function detectBrand(digits){
    let brand = null;
    if(/^4/.test(digits)) brand = 'visa';
    else if(/^(5[1-5]|2[2-7])/.test(digits)) brand = 'mastercard';

    if(brand === currentBrand) return;

    brandChipInner.classList.remove('show','swap');

    if(brand){
      const wasVisible = currentBrand !== null;
      brandChipInner.innerHTML = brandSvg[brand];
      void brandChipInner.offsetWidth;
      brandChipInner.classList.add(wasVisible ? 'swap' : 'show');
    } else {
      brandChipInner.innerHTML = '';
    }
    currentBrand = brand;
  }

  // ---------- formatting: expiry MM/AA ----------
  expiryEl.addEventListener('input', () => {
    let digits = expiryEl.value.replace(/\D/g,'').slice(0,4);
    if(digits.length >= 3){
      expiryEl.value = digits.slice(0,2) + ' / ' + digits.slice(2);
    } else {
      expiryEl.value = digits;
    }
    clearError('expiry');
  });

  // ---------- formatting: cvv, digits only ----------
  cvvEl.addEventListener('input', () => {
    cvvEl.value = cvvEl.value.replace(/\D/g,'').slice(0,4);
    clearError('cvv');
  });

  holderEl.addEventListener('input', () => clearError('holder'));



  function clearError(field){
    errs[field].textContent = '';
    inputEls[field].classList.remove(...INVALID_CLASSES);
  }
  function setError(field, msg){
    errs[field].textContent = msg;
    const el = inputEls[field];
    el.classList.add(...INVALID_CLASSES);
    el.classList.remove('input-shake');
    void el.offsetWidth;
    el.classList.add('input-shake');
  }

  /**
   * Validation avancée des numéros de cartes Visa et Mastercard.
   */
  function validateBankCard(input){
    const number = String(input ?? '').replace(/[\s-]/g,'');

    const result = {
      valid: false, brand: null, brandName: null, length: number.length,
      last4: number.slice(-4), masked: null, luhnValid: false,
      isTestNumber: false, error: null
    };

    if(!/^\d+$/.test(number)){
      result.error = 'Le numéro doit contenir uniquement des chiffres.';
      return result;
    }
    if(number.length < 13 || number.length > 19){
      result.error = 'Longueur de carte invalide.';
      return result;
    }

    const firstDigit = number[0];
    const first2 = Number(number.slice(0,2));
    const first4 = Number(number.slice(0,4));

    if(firstDigit === '4'){
      result.brand = 'visa'; result.brandName = 'Visa';
      if(![13,16,19].includes(number.length)){
        result.error = 'Longueur Visa invalide.';
        return result;
      }
    } else if((first2 >= 51 && first2 <= 55) || (first4 >= 2221 && first4 <= 2720)){
      result.brand = 'mastercard'; result.brandName = 'Mastercard';
      if(number.length !== 16){
        result.error = 'Longueur Mastercard invalide.';
        return result;
      }
    } else {
      result.error = 'Carte Visa ou Mastercard non reconnue.';
      return result;
    }

    let sum = 0, doubleDigit = false;
    for(let i = number.length - 1; i >= 0; i--){
      let digit = Number(number[i]);
      if(doubleDigit){
        digit *= 2;
        if(digit > 9) digit -= 9;
      }
      sum += digit;
      doubleDigit = !doubleDigit;
    }
    result.luhnValid = sum % 10 === 0;
    if(!result.luhnValid){
      result.error = 'Numéro de carte invalide.';
      return result;
    }

    const testNumbers = new Set([
      '4111111111111111','4242424242424242','4000000000000002',
      '5555555555554444','5105105105105100','2223000048400011'
    ]);
    result.isTestNumber = testNumbers.has(number);
    result.masked = '*'.repeat(number.length - 4) + result.last4;
    result.valid = true;
    return result;
  }

  /**
   * Validation avancée de la date d'expiration (format MM/AA, ex. 12/54).
   */
  function validateExpiryDate(expiryStr){
    const result = { valid:false, month:null, year:null, error:null };
    const m = String(expiryStr ?? '').replace(/\s/g,'').match(/^(\d{2})\/(\d{2})$/);
    if(!m){
      result.error = 'Format attendu : MM/AA.';
      return result;
    }
    const month = parseInt(m[1],10);
    const year = 2000 + parseInt(m[2],10);
    if(month < 1 || month > 12){
      result.error = 'Mois invalide.';
      return result;
    }
    const now = new Date();
    const finMoisExpiration = new Date(year, month, 0, 23, 59, 59);
    if(finMoisExpiration < now){
      result.error = 'Carte expirée.';
      return result;
    }
    result.valid = true;
    result.month = month;
    result.year = year;
    return result;
  }

  function validateClientSide(){
    let ok = true;
    const holder = holderEl.value.trim();
    const digits = numberEl.value.replace(/\D/g,'');
    const cvv = cvvEl.value;

    if(holder.length < 3 || !/^[a-zA-ZÀ-ÿ' -]+$/.test(holder)){
      setError('holder', 'Merci de saisir le nom du titulaire.');
      ok = false;
    }

    const cardCheck = validateBankCard(digits);
    if(!cardCheck.valid){
      setError('number', cardCheck.error || 'Numéro de carte invalide.');
      ok = false;
    }

    const expiryCheck = validateExpiryDate(expiryEl.value);
    if(!expiryCheck.valid){
      setError('expiry', expiryCheck.error || "Date d'expiration invalide.");
      ok = false;
    }

    if(cvv.length < 3){
      setError('cvv', 'CVV invalide.');
      ok = false;
    }

    return ok;
  }

  // ---------- captcha maison (canvas, aucun service tiers) ----------
  // Note sécurité : cette démo génère et vérifie le code uniquement côté
  // client (JS). En production, le code doit être généré côté serveur
  // (Symfony), stocké en session, et revérifié dans
  // PaiementController::verifier avant tout traitement.
  const CAPTCHA_CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let captchaCode = '';

  function randomColor(alpha){
    const palette = ['0,0,0','237,23,25','85,85,85','0,138,68'];
    const c = palette[Math.floor(Math.random()*palette.length)];
    return `rgba(${c},${alpha})`;
  }

  function drawCaptcha(code){
    const ctx = captchaCanvas.getContext('2d');
    const w = captchaCanvas.width, h = captchaCanvas.height;
    ctx.clearRect(0,0,w,h);

    ctx.fillStyle = '#f5f7f9';
    ctx.fillRect(0,0,w,h);

    for(let i=0;i<5;i++){
      ctx.strokeStyle = randomColor(.35);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(Math.random()*w, Math.random()*h);
      ctx.bezierCurveTo(Math.random()*w, Math.random()*h, Math.random()*w, Math.random()*h, Math.random()*w, Math.random()*h);
      ctx.stroke();
    }

    const n = code.length;
    const slot = w / n;
    ctx.textBaseline = 'middle';
    for(let i=0;i<n;i++){
      const cx = slot*i + slot/2 + (Math.random()*6-3);
      const cy = h/2 + (Math.random()*10-5);
      const angle = (Math.random()*36-18) * Math.PI/180;
      const size = 24 + Math.random()*6;
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(angle);
      ctx.font = `700 ${size}px Raleway, sans-serif`;
      ctx.fillStyle = randomColor(.92);
      ctx.textAlign = 'center';
      ctx.fillText(code[i], 0, 0);
      ctx.restore();
    }

    for(let i=0;i<40;i++){
      ctx.fillStyle = randomColor(.25);
      ctx.beginPath();
      ctx.arc(Math.random()*w, Math.random()*h, 1, 0, Math.PI*2);
      ctx.fill();
    }
  }

  function generateCaptcha(){
    let code = '';
    for(let i=0;i<5;i++){
      code += CAPTCHA_CHARS[Math.floor(Math.random()*CAPTCHA_CHARS.length)];
    }
    captchaCode = code;
    drawCaptcha(code);
    captchaInput.value = '';
    updatePayBtnState();
  }


  // ---------- submit : modal 3D Secure scoppé au formulaire, timeout 5 min, appel backend Symfony ----------

  const brandLabel = { visa: 'Visa Secure', mastercard: 'Mastercard ID Check' };

  function showTdsPanel(panel){
    [tdsLoading, tdsSuccess, tdsFail].forEach(p => {
      p.classList.remove('flex');
      p.classList.add('hidden');
      p.style.display = "none"
    });
    panel.classList.remove('hidden');
    panel.classList.add('flex');
    panel.style.display = "flex"
  }


  function restartIconAnimation(panel){
    const icon = panel.querySelector('svg')?.parentElement;
    if(!icon) return;
    const clone = icon.cloneNode(true);
    icon.replaceWith(clone);
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if(!validateClientSide()) return;

    payBtn.disabled = true;

    tdsHeadLabel.textContent = brandLabel[currentBrand] || '3D Secure';
    tdsBankRow.innerHTML = currentBrand
      ? `<div class="border border-luxe-border rounded-md px-2 h-[26px] flex items-center bg-luxe-black-alt">${brandSvg[currentBrand]}</div>`
      : '';
    const digits = numberEl.value.replace(/\D/g,'');
    tdsCardHint.textContent = '•••• ' + digits.slice(-4);

    showTdsPanel(tdsLoading);
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');

    const payload = {
      titulaire: holderEl.value.trim(),
      numero: digits,
      reservation_uuid: reservationUuid.value.trim(),
      expiration: expiryEl.value.replace(/\s/g,''),
      cvv: cvvEl.value
    };

    // En production, cet appel cible la route Symfony :
    //   POST /api/paiement/verifier  (voir PaiementController::verifier)
    // — sans jamais persister la carte. Ici, l'appel réseau est simulé
    // pour la démonstration (les artifacts publiés n'autorisent pas les
    // requêtes vers un backend externe) :
    verifierPaiement(payload)
  });


let abortController = null;
let timeoutHandle = null;
let pollingHandle = null;

const POLLING_INTERVAL = 30 * 1000; // 30 secondes
const MAX_DURATION = 5 * 60 * 1000; // 5 minutes

  async function verifierPaiement(payload) {
    // Annuler une éventuelle vérification précédente
    if (abortController) {
        abortController.abort();
    }
    clearTimeout(timeoutHandle);
    clearTimeout(pollingHandle);
    abortController = new AbortController();
    const controller = abortController;
    const startedAt = Date.now();

    let termine = false;

    // Arrêter toutes les vérifications
    function stopPolling() {
        termine = true;
        clearTimeout(timeoutHandle);
        clearTimeout(pollingHandle);
        controller.abort();
    }

    // Délai maximum de 5 minutes
    timeoutHandle = setTimeout(() => {
        if (termine) return;
        stopPolling();
        onFailure("Les paiements par carte sont temporairement indisponibles. Veuillez procéder par virement bancaire");
    }, MAX_DURATION);

    // Fonction de vérification du statut
    async function checkStatus() {
        if (termine || controller.signal.aborted) {
            return;
        }
        try {
            console.log(paymentUrl);
            const response = await fetch(paymentUrl.value, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Accept: "application/json",
                },
                body: JSON.stringify(payload),
                signal: controller.signal,
            });
            if (!response.ok) {
                throw new Error(`Erreur HTTP ${response.status}`);
            }
            const data = await response.json();
            console.log(data);
            // Vérification terminée entre-temps
            if (termine) return;
            switch (data.status) {
                case "success":
                    stopPolling();
                    onSuccess(data);
                    setTimeout(function(){
                        window.location.href = redirectUrl.value;
                    },2000);
                    return;

                case "failed":
                    stopPolling();
                    onFailure(data.message || "Les paiements par carte sont temporairement indisponibles. Procéder par virement bancaire.");
                    return;

                case "pending":
                    // Vérifier si les 5 minutes sont écoulées
                    if (Date.now() - startedAt >= MAX_DURATION) {
                        stopPolling();
                        onFailure("Les paiements par carte sont temporairement indisponibles. Procéder par virement bancaire.");
                        return;
                    }
                    // Relancer la vérification après 30 secondes
                    pollingHandle = setTimeout(checkStatus, POLLING_INTERVAL);
                    return;

                default:
                    stopPolling();
                    onFailure("Les paiements par carte sont temporairement indisponibles. Procéder par virement bancaire");
                    return;
            }
        } catch (error) {
            console.log(error);
            if (termine || error.name === "AbortError") {
                return;
            }
            console.error("Erreur de vérification du paiement :", error);
            stopPolling();
            onFailure("Les paiements par carte sont temporairement indisponibles. Procéder par virement bancaire.");
        }
    }
    checkStatus();
}


  function onSuccess(){
    restartIconAnimation(tdsSuccess);
    showTdsPanel(tdsSuccess);
  }

  function onFailure(message){
    tdsFailReason.textContent = message;
    restartIconAnimation(tdsFail);
    showTdsPanel(tdsFail);
  }

  tdsRetryBtn.addEventListener('click', () => {
    overlay.classList.remove('flex');
    overlay.classList.add('hidden');
    payBtn.disabled = false;
    generateCaptcha();
  });
})();
</script>
{% endblock %}