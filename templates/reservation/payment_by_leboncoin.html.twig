{% extends 'base.html.twig' %}
{% block title %}Paiement sécurisé Leboncoin — AutoPro{% endblock %}
{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">
    <h1 class="text-2xl font-display font-bold mb-1">Paiement sécurisé Leboncoin</h1>
    <p class="text-sm  text-luxe-muted mb-6">
        Merci de bien vouloir initier le paiement sécurisé via leboncoin et nous transmettre ensuite
        le bordereau de paiement.
        <br/>
        PNG ou JPG · Max 4 MB
    </p>
    <div class="mb-6">
        {% include 'components/_reservation_summary.html.twig' %}
    </div>
    <div class="card-luxe p-6">
        {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
            {{ form_row(form.file) }}
            <p class="text-xs text-luxe-muted mt-3">Formats acceptés : PDF, JPG, PNG, WEBP (8 Mo max).</p>
            <button type="submit" class="btn-gold w-full mt-6">Envoyer le bordereau</button>
        {{ form_end(form) }}
    </div>
     <div class="bg-luxe-card border border-luxe-orange/40 rounded-2xl mt-5 p-6" style="margin-top:20px;">
        <div class="flex items-center gap-2 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6 text-luxe-orange shrink-0" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.29 3.86a2 2 0 0 1 3.42 0l8.15 13.98A2 2 0 0 1 20.15 21H3.85a2 2 0 0 1-1.71-3.16l8.15-13.98ZM12 8.75a.75.75 0 0 1 .75.75v4a.75.75 0 0 1-1.5 0v-4a.75.75 0 0 1 .75-.75Zm0 9.25a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/>
            </svg>
            <h3 class="text-luxe-orange font-display font-semibold text-lg">Informations importantes</h3>
        </div>
        <p class="text-luxe-muted text-sm leading-relaxed">
            Pour ce qui est des paiements sécurisés
            via Leboncoin, seule la totalité du montant sera accepté.
        </p>
    </div>
</div>
{% endblock %}
