<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-50 flex flex-col">

<!-- top bar -->
<div class="h-1 bg-gray-100 border-b border-gray-200"></div>

<!-- main content -->
<div class="flex-1 flex items-start justify-center pt-16 px-4">
    <div class="w-full max-w-md bg-white border border-gray-200 rounded-2xl shadow-sm px-8 py-10">

        <!-- logo -->
        <div class="flex justify-center mb-8">
            <svg width="180" height="48" viewBox="0 0 180 48" xmlns="http://www.w3.org/2000/svg">
                <text x="90" y="34" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="30" fill="#1B4DB1">Votre<tspan fill="#F5A623">Marque</tspan></text>
            </svg>
        </div>

        <!-- form -->
        <form class="space-y-4">
            <div>
                <input
                        type="text"
                        placeholder="Email ou numéro de mobile"
                        class="w-full px-4 py-3.5 rounded-lg border border-blue-500 ring-1 ring-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-500 text-gray-800"
                >
            </div>
            <div>
                <input
                        type="password"
                        placeholder="Mot de passe"
                        class="w-full px-4 py-3.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-500 text-gray-800"
                >
            </div>

            <div>
                <a href="#" class="text-blue-600 font-medium hover:underline text-[15px]">Mot de passe oublié ?</a>
            </div>

            <button
                    type="submit"
                    class="w-full bg-blue-700 hover:bg-blue-800 transition-colors text-white font-semibold text-lg py-3.5 rounded-full"
            >
                Connexion
            </button>
        </form>

        <!-- divider -->
        <div class="flex items-center my-6">
            <div class="flex-1 h-px bg-gray-300"></div>
            <span class="px-4 text-gray-500 text-sm">ou</span>
            <div class="flex-1 h-px bg-gray-300"></div>
        </div>

        <!-- secondary action -->
        <button
                type="button"
                class="w-full border-2 border-gray-900 hover:bg-gray-50 transition-colors text-gray-900 font-semibold text-lg py-3.5 rounded-full"
        >
            Ouvrir un compte
        </button>

    </div>
</div>

<!-- footer -->
<footer class="bg-gray-100 border-t border-gray-200 py-5">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-blue-700 px-4">
        <a href="#" class="hover:underline">Contact</a>
        <a href="#" class="hover:underline">Respect de la vie privée</a>
        <a href="#" class="hover:underline">Contrats d'utilisation</a>
        <a href="#" class="hover:underline">International</a>
    </div>
</footer>

</body>
</html>