{% extends 'admin/_layout.html.twig' %}
{% block title %}Remboursements — Admin{% endblock %}
{% block body %}
<h1 class="text-2xl font-semibold mb-6">Demandes de remboursement</h1>

<div class="bg-luxe-card border border-luxe-border rounded-xl overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="text-luxe-muted uppercase text-xs tracking-widest">
            <tr><th class="text-left px-4 py-3">Réservation</th><th>Motif</th><th>IBAN</th><th>Statut</th><th>Reçue</th><th class="text-right px-4">Actions</th></tr>
        </thead>
        <tbody>
            {% for r in refunds %}
                <tr class="border-t border-luxe-border align-top">
                    <td class="px-4 py-3">
                        <a href="{{ path('admin_reservation_show', {id: r.reservation.id}) }}" class="text-luxe-gold font-mono text-xs">{{ r.reservation.reservationNumber }}</a>
                        <div class="text-xs text-luxe-muted">{{ r.reservation.customerName }}</div>
                    </td>
                    <td class="text-xs">
                        {{ r.reason }}
                        {% if r.customerComment %}<div class="text-luxe-muted mt-1 max-w-xs">{{ r.customerComment }}</div>{% endif %}
                    </td>
                    <td>
                        <code class="font-mono text-xs" id="iban-{{ r.id }}">{{ r.maskedIban }}</code>
                        <button type="button" class="btn-outline text-xs mt-1"
                                onclick="revealIban({{ r.id }}, '{{ csrf_token('refund_reveal_' ~ r.id)|e('js') }}')">
                            Révéler
                        </button>
                    </td>
                    <td class="text-xs">{{ r.status.label }}</td>
                    <td class="text-xs text-luxe-muted">{{ r.requestedAt|date('d/m/Y') }}</td>
                    <td class="text-right px-4">
                        <form method="post" action="{{ path('admin_refund_status', {id: r.id}) }}" class="inline-flex flex-col gap-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('refund_status_' ~ r.id) }}">
                            <select name="status" class="input-luxe text-xs">
                                <option value="RECEIVED"   {{ r.status.value == 'RECEIVED' ? 'selected' }}>Reçue</option>
                                <option value="PROCESSING" {{ r.status.value == 'PROCESSING' ? 'selected' }}>En cours</option>
                                <option value="REFUNDED"   {{ r.status.value == 'REFUNDED' ? 'selected' }}>Remboursée</option>
                                <option value="REJECTED"   {{ r.status.value == 'REJECTED' ? 'selected' }}>Refusée</option>
                            </select>
                            <button class="btn-outline text-xs">Enregistrer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-4 py-8 text-center text-luxe-muted">Aucune demande de remboursement.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
async function revealIban(id, token) {
    const res = await fetch('/admin/refunds/' + id + '/reveal-iban', {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: '_token=' + encodeURIComponent(token),
    });
    if (!res.ok) { alert('Impossible de révéler l\'IBAN.'); return; }
    const data = await res.json();
    document.getElementById('iban-' + id).textContent = data.iban;
    document.getElementById('iban-' + id).classList.add('text-luxe-gold');
}
</script>
{% endblock %}
