<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Administration — {{ site_setting('company_name') }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
</head>
<body class="bg-luxe-black text-luxe-text min-h-screen">
    {# ============ MOBILE TOP BAR (burger only visible < md) ============ #}
    <div class="md:hidden sticky top-0 z-30 flex items-center justify-between px-4 h-14 bg-luxe-black-alt border-b border-luxe-border">
        <a href="{{ path('admin_dashboard') }}">
                {% set logo =  site_setting('company_logo') %}
                {% if logo is empty %}
                    {% set logo = 'default_company_logo.png' %}
                {% endif %}
                <div class="flex items-center gap-2 font-semibold text-lg mb-4">
                    <a href="{{ path('home') }}" class="inline-block">
                        <img
                            src="{{ asset('uploads/logos/' ~ logo) }}"
                            alt="AUTOPRO"
                            class="h-full w-full object-contain"
                        >
                    </a>
                </div>
        </a>
        <button type="button" onclick="document.getElementById('admin-sidebar').classList.toggle('-translate-x-full')" class="w-10 h-10 rounded-full border border-luxe-border flex items-center justify-center text-white hover:text-luxe-orange hover:border-luxe-orange transition" aria-label="Menu">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M3 6.75A.75.75 0 013.75 6h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 6.75Zm0 5.25a.75.75 0 01.75-.75h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 12Zm.75 4.5a.75.75 0 000 1.5h16.5a.75.75 0 000-1.5H3.75Z"/></svg>
        </button>
    </div>

    <div class="flex min-h-screen">
        {# ============ SIDEBAR (fixed on mobile, sticky on desktop) ============ #}
        <aside id="admin-sidebar"
               class="fixed md:sticky md:translate-x-0 top-0 md:top-0 left-0 w-64 h-screen z-40 bg-luxe-black-alt border-r border-luxe-border p-4 transform -translate-x-full md:translate-x-0 transition-transform duration-200 shrink-0 overflow-y-auto">
            <div class=" flex items-center justify-between">
                <a href="{{ path('admin_dashboard') }}">
                {% set logo =  site_setting('company_logo') %}
                {% if logo is empty %}
                    {% set logo = 'default_company_logo.png' %}
                {% endif %}
                <img
                            src="{{ asset('uploads/logos/' ~ logo) }}"
                            alt="AUTOPRO"
                            class="h-full w-full object-contain"
                        >
                </a>
                <button type="button" onclick="document.getElementById('admin-sidebar').classList.add('-translate-x-full')" class="md:hidden text-luxe-muted hover:text-white" aria-label="Fermer">
