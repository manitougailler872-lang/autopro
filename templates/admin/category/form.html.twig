{% extends 'admin/_layout.html.twig' %}
{% block title %}{{ is_new ? 'Nouvelle catégorie' : 'Éditer catégorie' }} — Admin{% endblock %}
{% block body %}
<h1 class="text-2xl font-display font-bold mb-6">{{ is_new ? 'Nouvelle catégorie' : category.name }}</h1>

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 card-luxe p-6">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="space-y-4">
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {{ form_row(form.icon) }}
                {{ form_row(form.position) }}
                {{ form_row(form.active) }}
            </div>
            <div class="mt-6 flex gap-3">
                <button type="submit" class="btn-gold">{{ is_new ? 'Créer' : 'Enregistrer' }}</button>
                <a href="{{ path('admin_category_index') }}" class="btn-outline">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
