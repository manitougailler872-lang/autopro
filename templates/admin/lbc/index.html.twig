{% extends 'admin/_layout.html.twig' %}
{% block title %}Liens LBC — Admin{% endblock %}
{% block body %}
<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-display font-bold">Liens LBC</h1>
    <a href="{{ path('admin_lbc_new') }}" class="btn-gold">+ Ajouter</a>
</div>
<div class="card-luxe overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="text-luxe-muted uppercase text-xs tracking-widest">
            <tr>
                <th class="text-left">Client</th>
                <th>Garage</th>
                <th>Reference Leboncoin</th>
                <th>Véhicule</th>
                <th>Expiré</th>
                <th class="text-right px-4">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for b in links %}
                <tr class="border-t border-luxe-border">
                    <td class="px-4 py-3">{{ b.client }}</td>
                    <td class="font-semibold">{{ b.you }}</td>
                    <td class="text-luxe-muted text-xs font-mono">{{ b.referenceLbc }}</td>
                    <td class="text-luxe-muted text-xs font-mono">{{ b.reservation.vehicle.brand }}</td>
                    <td>
                        {% if b.expired %}
                            <span class="text-green-400 text-xs">● Expiré</span>
                        {% else %}
                            <span class="text-luxe-muted text-xs">○ Actif</span>
                        {% endif %}
                    </td>
                    <td class="text-right px-4">
                        <div class="inline-flex gap-1 flex-wrap justify-end">
                            <form method="post" action="{{ path('admin_lbc_delete', {id: b.id}) }}" class="inline" onsubmit="return confirm('Supprimer ce lien ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('lbc_delete_' ~ b.id) }}">
                                <button class="btn-outline text-xs py-1.5 px-3 text-red-400 border-red-500/40">Suppr.</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-4 py-8 text-center text-luxe-muted">Aucune marque. Cliquez sur "Ajouter" pour commencer.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
