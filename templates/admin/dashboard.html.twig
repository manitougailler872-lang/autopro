{% extends 'admin/_layout.html.twig' %}
{% block title %}Tableau de bord — Admin{% endblock %}
{% block body %}
<h1 class="text-2xl font-semibold mb-6">Tableau de bord</h1>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    {% for card in [
        {n: stats.total_vehicles,     l: 'Véhicules'},
        {n: stats.published_vehicles, l: 'Publiés'},
        {n: stats.pending,            l: 'Réservations en attente'},
        {n: stats.confirmed,          l: 'Réservations confirmées'},
        {n: stats.proofs_received,    l: 'Preuves reçues'},
        {n: stats.refunds,            l: 'Remboursements'},
        {n: stats.reviews_pending,    l: 'Avis à modérer'},
        {n: credit,    l: 'Crédits Sms Restants'},
    ] %}
        <div class="bg-luxe-card border border-luxe-border rounded-xl p-5">
            <div class="text-3xl font-bold text-luxe-gold">{{ card.n }}</div>
            <div class="text-xs text-luxe-muted uppercase tracking-wider mt-1">{{ card.l }}</div>
        </div>
    {% endfor %}
</div>

<div class="bg-luxe-card border border-luxe-border rounded-xl p-6">
    <h2 class="font-semibold mb-4">Dernières réservations</h2>
    {% if recent_reservations|length == 0 %}
        <p class="text-sm text-luxe-muted">Aucune réservation pour l'instant.</p>
    {% else %}
        <table class="w-full text-sm">
            <thead class="text-luxe-muted uppercase text-xs tracking-widest">
                <tr><th class="text-left py-2">N°</th><th class="text-left">Client</th><th class="text-left">Véhicule</th><th class="text-left">Montant</th><th class="text-left">Statut</th><th></th></tr>
            </thead>
            <tbody>
                {% for r in recent_reservations %}
                    <tr class="border-t border-luxe-border">
                        <td class="py-3 text-luxe-gold">{{ r.reservationNumber }}</td>
                        <td>{{ r.customerName }}</td>
                        <td>{{ r.vehicle.brand }} {{ r.vehicle.model }}</td>
                        <td>{{ r.reservationFeeAmount|money_eur }}</td>
                        <td>{% include 'components/_status_badge.html.twig' with {status: r.status} %}</td>
                        <td class="text-right"><a href="{{ path('admin_reservation_show', {id: r.id}) }}" class="btn-outline text-xs">Voir</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
