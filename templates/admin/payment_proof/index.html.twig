{% extends 'admin/_layout.html.twig' %}
{% block title %}Preuves de virement — Admin{% endblock %}
{% block body %}
<h1 class="text-2xl font-semibold mb-6">Preuves de virement</h1>

<div class="bg-luxe-card border border-luxe-border rounded-xl overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="text-luxe-muted uppercase text-xs tracking-widest">
            <tr><th class="text-left px-4 py-3">Réservation</th><th>Fichier</th><th>Type</th><th>Taille</th><th>Envoyé le</th><th class="text-right px-4">Action</th></tr>
        </thead>
        <tbody>
            {% for p in proofs %}
                <tr class="border-t border-luxe-border">
                    <td class="px-4 py-3">
                        <a href="{{ path('admin_reservation_show', {id: p.reservation.id}) }}" class="text-luxe-gold font-mono text-xs">{{ p.reservation.reservationNumber }}</a>
                        <div class="text-xs text-luxe-muted">{{ p.reservation.customerName }}</div>
                    </td>
                    <td>{{ p.originalFilename }}</td>
                    <td class="text-xs text-luxe-muted">{{ p.mimeType }}</td>
                    <td>{{ (p.fileSize/1024)|round }} Ko</td>
                    <td>{{ p.uploadedAt|date('d/m/Y H:i') }}</td>
                    <td class="text-right px-4"><a href="{{ path('admin_payment_proof_download', {id: p.id}) }}" class="btn-outline text-xs">Télécharger</a></td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-4 py-8 text-center text-luxe-muted">Aucune preuve reçue.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
