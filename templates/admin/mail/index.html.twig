{% extends 'admin/_layout.html.twig' %}
{% block title %}E-mail — Admin{% endblock %}
{% block body %}
<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-display font-bold">E-mail</h1>
    <a href="{{ path('admin_mail_new') }}" class="btn-gold">+ Nouveau</a>
</div>
<div class="card-luxe overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="text-luxe-muted uppercase text-xs tracking-widest">
            <tr>
                <th class="text-left px-4 py-3">E-mail</th>
                <th class="text-left px-4 py-3">Véhicule</th>
                <th class="text-left px-4 py-3">Réservation</th>
                <th class="text-right px-4">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for mail in mails %}
                <tr class="border-t border-luxe-border">
                    <td class="px-4 py-3">{{ mail.email }}</td>
                    {% if mail.vehicle is  empty %}
                        <td class="px-4 py-3">-</td>
                    {% else %}
                        <td class="px-4 py-3">{{ mail.vehicle.brand ~ ' - ' ~ mail.vehicle.price ~  '€'}}</td>
                    {% endif %}
                    {% if mail.reservation is  empty %}
                        <td class="px-4 py-3">-</td>
                    {% else %}
                        <td class="px-4 py-3">{{ mail.reservation.reservationNumber}}</td>
                    {% endif %}
                    <td class="text-right px-4">
                        <div class="inline-flex gap-1 flex-wrap justify-end">
                            <form method="post" action="{{ path('admin_mail_delete', {id: mail.id}) }}" class="inline" onsubmit="return confirm('Supprimer cet email ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('mail_delete_' ~ mail.id) }}">
                                <button class="btn-outline text-xs py-1.5 px-3 text-red-400 border-red-500/40">Suppr.</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-4 py-8 text-center text-luxe-muted">Aucun mail créé. Cliquez sur "Nouveau" pour commencer.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
