<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion admin — AUTOPRO</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
</head>
<body class="bg-luxe-black text-luxe-text  min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-6">
            <div class="font-semibold text-2xl">AUTO <span class="text-luxe-gold">PRO</span></div>
            <p class="text-luxe-muted text-sm mt-1">Administration</p>
        </div>

        {% if error %}
            <div class="mb-4 p-3 rounded-lg bg-red-950/40 border border-red-700/40 text-red-300 text-sm">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" class="bg-luxe-card border border-luxe-border rounded-xl p-6">
            <label class="form-label" for="email">E-mail</label>
            <input type="email" id="email" name="_username" value="{{ last_username }}" class="input-luxe mb-4" required autofocus>

            <label class="form-label" for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" class="input-luxe mb-4" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-gold w-full">Se connecter</button>
        </form>
    </div>
</body>
</html>
