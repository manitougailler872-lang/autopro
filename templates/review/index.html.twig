{% extends 'base.html.twig' %}
{% block title %}Avis clients — {{ site_setting('company_name') }}{% endblock %}
{% block body %}
<div class="max-w-5xl mx-auto px-6 py-10">
    <h1 class="text-3xl font-semibold mb-8">Avis de nos clients</h1>

    {% if reviews|length == 0 %}
        <p class="text-luxe-muted mb-8">Soyez le premier à laisser un avis.</p>
    {% else %}
        <div class="grid md:grid-cols-2 gap-4 mb-12">
            {% for r in reviews %}
                {% include 'components/_review_card.html.twig' with {review: r} %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="bg-luxe-card border border-luxe-border rounded-xl p-6">
        <h2 class="text-xl font-semibold mb-4">Laisser un avis</h2>
        {{ form_start(form) }}
            <div class="grid md:grid-cols-2 gap-4">
                <div>{{ form_row(form.customerName) }}</div>
                <div>{{ form_row(form.rating) }}</div>
                <div class="md:col-span-2">{{ form_row(form.comment) }}</div>
            </div>
            <button type="submit" class="btn-gold mt-4">Envoyer mon avis</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
