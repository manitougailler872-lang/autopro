{# <script src="//code.tidio.co/azzi1tnmbbilqorbq8zly5rtd03qtenp.js" async></script>
============================================================
   Script partagé : à déplacer dans base.html.twig (une seule fois)
   si cette carte est incluse plusieurs fois sur la même page.
   Le garde (window.__luxeAuctionInit) évite les doublons.
   ============================================================ #}
<script>
(function () {
    if (window.__luxeAuctionInit) return;
    window.__luxeAuctionInit = true;

    function format(diffMs) {
        if (diffMs <= 0) return null;
        var totalSec = Math.floor(diffMs / 1000);
        var days = Math.floor(totalSec / 86400);
        var hours = Math.floor((totalSec % 86400) / 3600);
        var minutes = Math.floor((totalSec % 3600) / 60);
        var seconds = totalSec % 60;
        var pad = function (n) { return String(n).padStart(2, '0'); };

        if (days > 0) {
            return days + 'j ' + pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
        }
        return pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
    }

    function tick() {
        document.querySelectorAll('.js-auction-band[data-expired="false"]').forEach(function (band) {
            var end = new Date(band.dataset.end).getTime();
            var diff = end - Date.now();
            var valueEl = band.querySelector('.js-auction-value');
            var labelEl = band.querySelector('.js-auction-label');
            var liveEl = band.querySelector('.js-auction-live');

            var formatted = format(diff);
            if (formatted === null) {
                band.dataset.expired = 'true';
                labelEl.textContent = 'Enchère terminée';
                valueEl.textContent = '00:00:00';
                if (liveEl) liveEl.remove();
                return;
            }
            valueEl.textContent = formatted;
        });
    }

    tick();
    setInterval(tick, 1000);
})();
</script> 
