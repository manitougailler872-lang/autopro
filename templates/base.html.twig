<script>
(function () {
    const notif    = document.getElementById('visitor-notif');
    const counter  = document.getElementById('visitor-count');
    if (!notif || !counter) return;

    const START_COUNT   = 763;
    const INCREMENT     = 4;
    const INTERVAL_MS   = 10000;   // Cycle 10s
    const VISIBLE_MS    = 5000;    // Reste visible 5s à chaque cycle

    // Persistance du compteur entre pages
    let count = parseInt(sessionStorage.getItem('visitorCount') || START_COUNT, 10);
    counter.textContent = count.toLocaleString('fr-FR');

    function show() {
        if (notif.dataset.closed === '1') return;
        notif.classList.remove('opacity-0', 'translate-y-4');
        notif.classList.add('opacity-100', 'translate-y-0');
    }

    function hide() {
        notif.classList.remove('opacity-100', 'translate-y-0');
        notif.classList.add('opacity-0', 'translate-y-4');
    }

    function tick() {
        // 1. Incrémente le compteur
        count += INCREMENT;
        sessionStorage.setItem('visitorCount', count.toString());

        // 2. Micro-animation sur le nombre
        counter.style.transform = 'scale(1.15)';
        counter.style.transition = 'transform 0.2s ease-out';
        counter.textContent = count.toLocaleString('fr-FR');
        setTimeout(() => { counter.style.transform = 'scale(1)'; }, 200);

        // 3. Affiche, puis masque après VISIBLE_MS
        show();
        setTimeout(hide, VISIBLE_MS);
    }

    // Première apparition ~1s après chargement
    setTimeout(tick, 1000);

    // Puis toutes les 10s
    setInterval(tick, INTERVAL_MS);
})();
</script>

<script>
(function () {
  'use strict';
 
  // --- Éléments du DOM ---
  const section         = document.getElementById('simulateur');
  const boutonsType      = document.querySelectorAll('.type-btn');
  const inputMontant      = document.getElementById('montant');
  const inputDuree        = document.getElementById('duree');
  const montantAffiche     = document.getElementById('montantAffiche');
  const dureeAffichee      = document.getElementById('dureeAffichee');
  const mensualiteEl       = document.getElementById('mensualite');
  const tauxActuelEl       = document.getElementById('tauxActuel');
  const montantTotalDuEl   = document.getElementById('montantTotalDu');
  const coutTotalCreditEl  = document.getElementById('coutTotalCredit');
  const toggleTableauBtn   = document.getElementById('toggleTableau');
  const toggleTableauLabel = document.getElementById('toggleTableauLabel');
  const toggleTableauIcon  = document.getElementById('toggleTableauIcon');
  const tableauWrapper     = document.getElementById('tableauWrapper');
  const tableauCorps       = document.getElementById('tableauCorps');
 
 console.log(document.querySelector('.type-btn[data-active="true"]'));

  // --- État ---
  let tauxActuel = parseFloat(
    document.querySelector('.type-btn[data-active="true"]').dataset.taux
  );
 
  // --- Utilitaires ---
  function formatMontant(valeur) {
    return Math.round(valeur).toLocaleString('fr-FR');
  }
 
  function calculerMensualite(capital, tauxAnnuel, dureeMois) {
    const r = (tauxAnnuel / 100) / 12;
    if (r === 0) return capital / dureeMois;
    return capital * r * Math.pow(1 + r, dureeMois) / (Math.pow(1 + r, dureeMois) - 1);
  }
 
  function genererTableauAmortissement(capital, tauxAnnuel, dureeMois, mensualite) {
    const r = (tauxAnnuel / 100) / 12;
    let capitalRestant = capital;
    const lignes = [];
 
    for (let i = 1; i <= dureeMois; i++) {
      const interets = capitalRestant * r;
      const capitalRembourse = mensualite - interets;
      capitalRestant = Math.max(capitalRestant - capitalRembourse, 0);
 
      lignes.push({
        numero: i,
        mensualite: mensualite,
        capital: capitalRembourse,
        interets: interets,
        capitalRestant: capitalRestant,
      });
    }
 
    return lignes;
  }
 
  // --- Rendu ---
  function mettreAJour() {
    const montant = parseFloat(inputMontant.value);
    const duree = parseInt(inputDuree.value, 10);
 
    const mensualite = calculerMensualite(montant, tauxActuel, duree);
    const montantTotalDu = mensualite * duree;
    const coutTotalCredit = montantTotalDu - montant;
 
    montantAffiche.textContent = formatMontant(montant);
    dureeAffichee.textContent = duree;
    tauxActuelEl.textContent = tauxActuel.toFixed(1).replace('.', ',');
    mensualiteEl.textContent = formatMontant(mensualite);
    montantTotalDuEl.textContent = formatMontant(montantTotalDu);
    coutTotalCreditEl.textContent = formatMontant(coutTotalCredit);
 
    // Ne régénère le tableau que s'il est visible, pour épargner du travail inutile
    if (!tableauWrapper.hidden) {
      genererLignesTableau(montant, duree, mensualite);
    }
  }
 
  function genererLignesTableau(montant, duree, mensualite) {
    const lignes = genererTableauAmortissement(montant, tauxActuel, duree, mensualite);
 
    tableauCorps.innerHTML = lignes.map(function (ligne) {
      return (
        '<tr class="border-t border-luxe-border">' +
          '<td class="px-4 py-2.5 text-luxe-muted font-mono">' + ligne.numero + '</td>' +
          '<td class="px-4 py-2.5 text-right font-mono text-luxe-text">' + formatMontant(ligne.mensualite) + ' €</td>' +
          '<td class="px-4 py-2.5 text-right font-mono text-luxe-muted">' + formatMontant(ligne.capital) + ' €</td>' +
          '<td class="px-4 py-2.5 text-right font-mono text-luxe-muted">' + formatMontant(ligne.interets) + ' €</td>' +
          '<td class="px-4 py-2.5 text-right font-mono text-luxe-text">' + formatMontant(ligne.capitalRestant) + ' €</td>' +
        '</tr>'
      );
    }).join('');
  }
 
  // --- Écouteurs ---
  boutonsType.forEach(function (btn) {
    btn.addEventListener('click', function () {
      boutonsType.forEach(function (b) {
        b.dataset.active = 'false';
        b.classList.remove('bg-luxe-orange', 'text-luxe-text', 'border-luxe-orange', 'font-medium');
        b.classList.add('bg-luxe-faint', 'text-red', 'active:text-white', 'text-white', 'border-luxe-orange', 'font-medium');
      });
 
      btn.dataset.active = 'true';
      btn.classList.remove('bg-luxe-card', 'text-luxe-muted', 'border-luxe-border');
      btn.classList.add('bg-luxe-orange', 'text-white', 'border-luxe-orange', 'font-medium');
 
      tauxActuel = parseFloat(btn.dataset.taux);
      mettreAJour();
    });
  });
 
  inputMontant.addEventListener('input', mettreAJour);
  inputDuree.addEventListener('input', mettreAJour);
 
  toggleTableauBtn.addEventListener('click', function () {
    const estVisible = !tableauWrapper.hidden;
 
    tableauWrapper.hidden = estVisible;
    toggleTableauIcon.classList.toggle('rotate-180', !estVisible);
    toggleTableauLabel.textContent = estVisible
      ? 'Voir le tableau d’amortissement'
      : 'Masquer le tableau d’amortissement';
 
    if (!estVisible) {
      const montant = parseFloat(inputMontant.value);
      const duree = parseInt(inputDuree.value, 10);
      const mensualite = calculerMensualite(montant, tauxActuel, duree);
      genererLignesTableau(montant, duree, mensualite);
    }
  });
 
  // --- Calcul initial ---
  mettreAJour();
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach((item) => {
        const button = item.querySelector('.faq-button');
        const content = item.querySelector('.faq-content');
        const icon = item.querySelector('.faq-icon');

        button.addEventListener('click', () => {

            const isOpen = button.getAttribute('aria-expanded') === 'true';

            // Fermer les autres
            faqItems.forEach((otherItem) => {
                const otherButton = otherItem.querySelector('.faq-button');
                const otherContent = otherItem.querySelector('.faq-content');
                const otherIcon = otherItem.querySelector('.faq-icon');

                otherButton.setAttribute('aria-expanded', 'false');
                otherContent.classList.add('hidden');

                otherIcon.innerHTML = `
                    <path d="m5 8 5 5 5-5"/>
                `;

                otherIcon.classList.remove('rotate-180');
            });

            // Ouvrir l'élément sélectionné
            if (!isOpen) {
                button.setAttribute('aria-expanded', 'true');
                content.classList.remove('hidden');

                icon.innerHTML = `
                    <path d="m5 12 5-5 5 5"/>
                `;

                icon.classList.add('rotate-180');
            }
        });
    });
});
</script>
