    </div>
    <svg class="garage-chevron w-4 h-4 text-slate-300 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
  `;
  row.addEventListener('click', () => selectGarage(g.id, true));
  listEl.appendChild(row);
});

/* =========================================================
   MAP — Leaflet (OpenStreetMap), sans clé API requise
   ========================================================= */
const map = L.map('map', { zoomControl: false }).setView([48.78, 2.62], 10);

const planLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
  subdomains: 'abcd',
  maxZoom: 19
}).addTo(map);

const satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
  attribution: 'Tiles &copy; Esri',
  maxZoom: 19
});

L.control.zoom({ position: 'bottomright' }).addTo(map);

function pinSVG(active) {
  const fill = active ? '#e6342a' : '#0f1b3d';
  return `
    <svg viewBox="0 0 34 44" xmlns="http://www.w3.org/2000/svg">
      <path d="M17 0C7.6 0 0 7.6 0 17c0 11 17 27 17 27s17-16 17-27C34 7.6 26.4 0 17 0z" fill="${fill}"/>
      <circle cx="17" cy="17" r="7" fill="white"/>
    </svg>`;
}

function makeIcon(active) {
  return L.divIcon({
    className: '',
    html: `<div class="autopro-pin ${active ? 'is-active' : ''}">${pinSVG(active)}</div>`,
    iconSize: [34, 44],
    iconAnchor: [17, 44],
    popupAnchor: [0, -40]
  });
}

function popupHTML(g) {
  return `
    <div class="font-sans">
      <div class="h-28 bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center relative">
        <span class="text-white font-extrabold text-sm tracking-wide">AUTO<span class="text-brand">PRO</span></span>
      </div>
      <div class="p-4">
        <p class="font-bold text-navy leading-tight">${g.name}</p>
        <p class="text-slate-400 text-sm mb-2">${g.city}</p>
        <p class="text-slate-500 text-sm flex gap-1 mb-2">
          <svg class="w-4 h-4 text-brand flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          <span>${g.address}<br>${g.postal}</span>
        </p>
        <span class="inline-block mb-3 text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Ouvert aujourd'hui</span>
        <a href="https://www.google.com/maps/dir/?api=1&destination=${g.lat},${g.lng}" target="_blank" rel="noopener"
           class="flex items-center justify-center gap-2 bg-navy hover:bg-navy/90 text-white text-sm font-semibold rounded-xl py-2.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
          Itinéraire
        </a>
      </div>
    </div>`;
}

const markers = {};
GARAGES.forEach(g => {
  const marker = L.marker([g.lat, g.lng], { icon: makeIcon(false) }).addTo(map);
  marker.bindPopup(popupHTML(g), { closeButton: true, autoPan: true });
  marker.on('click', () => selectGarage(g.id, false));
  markers[g.id] = marker;
});

let activeId = GARAGES[0].id;

function selectGarage(id, flyTo) {
  activeId = id;
  const g = GARAGES.find(x => x.id === id);

  // list state
  document.querySelectorAll('.garage-card').forEach(el => {
    el.classList.toggle('is-active', Number(el.dataset.id) === id);
  });

  // marker state
  Object.entries(markers).forEach(([mid, m]) => {
    m.setIcon(makeIcon(Number(mid) === id));
  });

  markers[id].openPopup();
  if (flyTo) map.flyTo([g.lat, g.lng], 12, { duration: 0.6 });
}

// open first popup by default
selectGarage(GARAGES[0].id, false);
map.setView([GARAGES[0].lat, GARAGES[0].lng], 11);

// Plan / Satellite toggle
const btnPlan = document.getElementById('btn-plan');
const btnSat = document.getElementById('btn-sat');
btnPlan.addEventListener('click', () => {
  map.removeLayer(satLayer); map.addLayer(planLayer);
  btnPlan.className = 'px-4 py-1.5 rounded-full bg-navy text-white transition';
  btnSat.className = 'px-4 py-1.5 rounded-full text-slate-500 transition';
});
btnSat.addEventListener('click', () => {
  map.removeLayer(planLayer); map.addLayer(satLayer);
  btnSat.className = 'px-4 py-1.5 rounded-full bg-navy text-white transition';
  btnPlan.className = 'px-4 py-1.5 rounded-full text-slate-500 transition';
});
</script>
</body>
</html>
