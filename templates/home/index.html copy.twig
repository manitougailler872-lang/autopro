{% extends 'base.html.twig' %}
{% block title %}AUTO PRO — Trouvez le véhicule de vos rêves{% endblock %}

{% block body %}

{# ========== HERO ========== #}
<section class="relative overflow-hidden bg-luxe-black">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.75) 20%,
    rgba(255, 255, 255, 0.45) 50%,
    rgba(255, 255, 255, 0.10) 100%
), url({{ asset('images/bg-hero-3.png') }});"></div>
    <div class="absolute inset-0 bg-[url({{ asset('images/bg-hero-3.png') }})] bg-cover bg-bottom"></div>
    <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
        <div class="max-w-xl fade-in-up">
            <h1 class="text-4xl text-black md:text-5xl text-upper font-display font-bold leading-tight mb-6">
                Trouvez votre <br>prochaine voiture <br>
                chez&nbsp;<span class="text-luxe-orange">AUTOPRO</span>
            </h1>
            <p class="text-sm text-blanc mb-8 max-w-md leading-relaxed">
                Véhicules d'occasion sélectionnés, contrôlés et garantis
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('vehicle_list') }}" class="btn-gold">Notre collection</a>
                <a href="#contact" class="btn-outline text-white bg-black">Nous contacter</a>
            </div>
        </div>
    </div>
</section>

