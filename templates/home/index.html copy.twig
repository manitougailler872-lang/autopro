{# ========== POPULAR BRANDS (NEW) ========== #}
<section class="max-w-7xl mx-auto px-6 py-10 ">
    <h2 class="text-sm font-display font-semibold mb-8 tracking-wide">MARQUES POPULAIRES</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">
        {% for b in ['Peugeot','Renault','Volkswagen','KIA','Toyota','BMW','Mercedes','Audi'] %}
            {% if b == 'Audi' %}
                {% set logo = 'audi.svg' %}
            {% elseif b == 'Renault' %}
                {% set logo = 'renault.svg' %}
            {% elseif b == 'Peugeot' %}
                {% set logo = 'peugeot.svg' %}
            {% elseif b == 'BMW' %}
                {% set logo = 'bmw.svg' %}
            {% elseif b == 'Mercedes' %}
                {% set logo = 'mercedes.svg' %}
            {% elseif b == 'KIA' %}
                {% set logo = 'kia.png' %}
            {% elseif b == 'Toyota' %}
                {% set logo = 'toyota.png' %}
            {% elseif b == 'Volkswagen' %}
                {% set logo = 'volks.png' %}
            {% else %}
                {% set logo = 'renault.svg' %}
            {% endif %}
            <a href="{{ path('vehicle_list', {brand: b}) }}" class="card-luxe gap-2 bg-white border-1 border-luxe-border px-4 py-6 flex items-center justify-center text-luxe-muted hover:text-luxe-orange hover:border-luxe-orange transition flex-col font-display font-semibold text-sm">
                <img
                    src="{{ asset('images/marques/' ~ logo) }}"
                    alt="LUXE CAR"
                    class="h-8 w-10 mx-1 text-white inline-block object-cover"
                >
                {{ b }}
            </a>
        {% endfor %}
    </div>
</section>

{% set partners = partners|default([
    {name: 'ARVAL', logo: 'v2_content_logo_arval.webp'},
    {name: 'Athlon', logo: 'v2_content_logo_athlon.webp'},
    {name: 'Ayvens', logo: 'v2_content_logo_ayvens.webp'},
    {name: 'Hertz', logo: 'v2_content_logo_hertz.webp'},
    {name: 'Avis', logo: 'v2_content_logo_avis.webp'},
    {name: 'DriveMe', logo: 'driveme.png'},
    {name: 'STCV', logo: 'stcv.png'},
]) %}
<section class="max-w-7xl mx-auto bg-luxe-black">
    <div class="max-w-6xl mx-auto px-4">
        <p class="text-center text-sm font-semibold text-neutral-400 uppercase tracking-widest mb-10"></p>
        <div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
                {% for i in 1..2 %}
                    <div class="flex items-center gap-16 pr-16 shrink-0" {% if i == 2 %}aria-hidden="true"{% endif %}>
                        {% for partner in partners %}
                            <img src="{{ asset('images/partners/' ~ partner.logo) }}"
                                 alt="{{ i == 1 ? partner.name : '' }}"
                                 class="h-8 w-auto hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>




