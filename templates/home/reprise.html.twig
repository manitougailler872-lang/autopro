{% extends 'base.html.twig' %}
{% block title %}AutoPro - Reprises de vos véhicules{% endblock %}
{% block body %}
    <section class="bg-luxe-text text-white">
        <div class="max-w-7xl mx-auto px-5 py-20 grid lg:grid-cols-2 gap-12 items-center">
            <div class="mb-4">
                <span class="text-luxe-orange text-xs font-extrabold uppercase tracking-widest"
                    >Reprise de véhicule</span
                >
                <h1 class="mt-4 text-5xl font-extrabold text-black">Faites reprendre votre véhicule simplement.</h1>
                <p class="mt-6 text-lg text-black leading-8 pr-4">
                    Vous amenez votre véhicule. Notre équipe l’évalue, vous propose une offre, puis vous
                    choisissez entre une vente directe ou un échange avec complément.
                </p>
                <a
                    href="{{path('contact')}}"
                    class="inline-block mt-8 bg-luxe-orange hover:bg-luxe-orange-dark px-6 py-3 rounded-xl font-bold"
                    >Demander une estimation</a
                >
            </div>
            <div class="border border-white/10 rounded-3xl p-8 bg-luxe-card/5 space-y-6">
                <div class="flex gap-4">
                    <div
                        class="w-10 h-10 shrink-0 rounded-full bg-luxe-orange hover:bg-luxe-orange-dark flex items-center justify-center font-bold"
                    >
                        1
                    </div>
                    <div>
                        <b>Vous amenez votre véhicule</b>
                        <p class="text-sm text-luxe-muted mt-1">
                            Avec ses documents et, si possible, son historique d’entretien.
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div
                        class="w-10 h-10 shrink-0 rounded-full bg-luxe-orange hover:bg-luxe-orange-dark flex items-center justify-center font-bold"
                    >
                        2
                    </div>
                    <div>
                        <b>Évaluation du véhicule</b>
                        <p class="text-sm text-luxe-muted mt-1">
                            État général, kilométrage, entretien, marché et caractéristiques sont étudiés.
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div
                        class="w-10 h-10 shrink-0 rounded-full bg-luxe-orange hover:bg-luxe-orange-dark flex items-center justify-center font-bold"
                    >
                        3
                    </div>
                    <div>
                        <b>Proposition de reprise</b>
                        <p class="text-sm text-luxe-muted mt-1">
                            Nous vous présentons une offre après l’évaluation.
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div
                        class="w-10 h-10 shrink-0 rounded-full bg-luxe-orange hover:bg-luxe-orange-dark flex items-center justify-center font-bold"
                    >
                        4
                    </div>
                    <div>
                        <b>Achat ou échange + complément</b>
                        <p class="text-sm text-luxe-muted mt-1">
                            Vous pouvez vendre votre véhicule ou utiliser sa valeur comme apport sur un autre
                            véhicule.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="max-w-7xl mx-auto px-5 py-16">
        <h2 class="text-3xl font-extrabold">Deux options selon votre projet</h2>
        <div class="grid md:grid-cols-2 gap-6 mt-8">
            <div class="border border-luxe-border rounded-3xl p-8">
                <span class="text-luxe-orange font-bold">Option 1</span>
                <h3 class="text-2xl font-extrabold mt-2">Vente directe</h3>
                <p class="mt-3 text-luxe-muted">
                    Si l’offre vous convient, AUTOPRO EXPRESS peut reprendre directement votre véhicule selon
                    les conditions convenues.
                </p>
            </div>
            <div class="border border-luxe-border rounded-3xl p-8">
                <span class="text-luxe-orange font-bold">Option 2</span>
                <h3 class="text-2xl font-extrabold mt-2">Échange + complément</h3>
                <p class="mt-3 text-luxe-muted">
                    La valeur de reprise peut servir d’apport sur le véhicule que vous souhaitez acheter. Vous
                    réglez ensuite le complément.
                </p>
            </div>
        </div>
    </section>
{% endblock %}
