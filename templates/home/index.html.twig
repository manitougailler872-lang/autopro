{% set partners = partners|default([
    {name: 'ARVAL', logo: 'v2_content_logo_arval.webp'},
    {name: 'Athlon', logo: 'v2_content_logo_athlon.webp'},
    {name: 'Ayvens', logo: 'v2_content_logo_ayvens.webp'},
    {name: 'Hertz', logo: 'v2_content_logo_hertz.webp'},
    {name: 'Avis', logo: 'v2_content_logo_avis.webp'},
    {name: 'DriveMe', logo: 'driveme.png'},
    {name: 'STCV', logo: 'stcv.png'},
]) %}
<section class="max-w-7xl mx-auto bg-luxe-black mb-4">
    <div class="max-w-6xl mx-auto px-4">
        <p class="text-center text-sm font-semibold text-neutral-400 uppercase tracking-widest mb-10"></p>
        <div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
                {% for i in 1..2 %}
                    <div class="flex items-center gap-16 pr-16 shrink-0" {% if i == 2 %}aria-hidden="true"{% endif %}>
                        {% for partner in partners %}
                            <img src="{{ asset('images/partners/' ~ partner.logo) }}"
                                 alt="{{ i == 1 ? partner.name : '' }}"
                                 class="h-8 w-auto hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

