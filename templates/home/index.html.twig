    <script>
(function () {
  const modal      = document.getElementById('vehicle-modal');
  const closeBtn   = document.getElementById('modal-close');
  const mainPhoto  = document.getElementById('main-photo');
  const thumbBtns  = Array.from(document.querySelectorAll('.thumb-btn'));
  const prevBtn    = document.getElementById('thumb-prev');
  const nextBtn    = document.getElementById('thumb-next');

  // Ring/active state classes applied to the selected thumbnail
  const ACTIVE_CLASSES   = ['ring-2', 'ring-red-600'];
  const INACTIVE_CLASSES = ['ring-1', 'ring-neutral-200'];

  let current = 0; // index of the photo currently shown in the main image
  function setActiveThumb(index) {
    thumbBtns.forEach((btn, i) => {
      const isActive = i === index;
      btn.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
      btn.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
    });
  }
  // --- Close modal ---
  function closeModal() {
    modal.classList.add('hidden');
    // If you open this modal dynamically (e.g. from a "Voir" button on a
    // vehicle card), you probably want to remove it instead:
    // modal.remove();
  }
  closeBtn.addEventListener('click', closeModal);
  // Click on the dark backdrop (outside the white card) also closes it
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
})();
</script>
{% endif %}


